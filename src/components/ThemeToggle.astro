---
import { THEME_CONTROL_SCRIPT } from './ui/themeControl'

/**
 * Theme switch for the Settings page (PROJECT.md §26). The header has the
 * same three choices as a menu (ThemeMenu.astro); both run one script,
 * ui/themeControl.ts, so they cannot disagree.
 *
 * Three states rather than two: system, dark, light. "System" has to be a real
 * option, not just the initial default — someone who switches their OS to light
 * in the evening expects the site to follow, and a two-state toggle strands
 * them on whatever they last picked.
 *
 * No JavaScript framework: this is one attribute on `<html>` and one value in
 * localStorage, so it is an inline script. That also means it works before any
 * island hydrates, which matters because a theme that arrives late is a flash
 * of the wrong one.
 *
 * Styled by the shared `.mf-segmented` rules and driven by `aria-checked`, so
 * the selected state is the ARIA state — there is no second, visual copy of it
 * for the two to disagree. The arrow-key handling mirrors ui/roving.ts, which
 * cannot be imported into an inline script.
 *
 * Settings passes this into its island as a slot, so the markup arrives as
 * static HTML and the inline script binds it as soon as it is parsed.
 */
const options = [
  { value: 'system', label: 'Follow system theme' },
  { value: 'dark', label: 'Dark theme' },
  { value: 'light', label: 'Light theme' },
] as const
---

<div
  class="mf-segmented mf-segmented-sm mf-segmented-icons"
  role="radiogroup"
  aria-label="Colour theme"
  data-theme-toggle
>
  {
    options.map(({ value, label }) => (
      <button
        type="button"
        role="radio"
        aria-checked={value === 'system' ? 'true' : 'false'}
        tabindex={value === 'system' ? '0' : '-1'}
        data-theme-value={value}
        aria-label={label}
        class="mf-segment"
      >
        {value === 'system' && (
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <rect x="2" y="3" width="20" height="14" rx="2" />
            <path d="M8 21h8M12 17v4" />
          </svg>
        )}
        {value === 'dark' && (
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
          </svg>
        )}
        {value === 'light' && (
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
        )}
      </button>
    ))
  }
</div>

<script is:inline set:html={THEME_CONTROL_SCRIPT} />
