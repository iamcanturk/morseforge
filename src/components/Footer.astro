---
import { Logo } from './brand/Logo'
import { siteNav } from './ui/siteNav'
import Rich from './I18n/Rich.astro'
import LocaleSwitcher from './I18n/LocaleSwitcher.astro'
import { useTranslations } from '../i18n/server'
import { AUTHOR, AUTHOR_X_URL, SITE } from '../config/site'
import { encode, prettify } from '../engine/morseEncoder'

/**
 * The station plate.
 *
 * The link groups repeat the header's on purpose: a reader who reaches the
 * bottom of an article has finished with it and is deciding where to go, and
 * for a crawler this is a sitemap on every page.
 *
 * `rel="me"` marks the links that are the *same person* — the author's own site
 * and X profile — which is what IndieAuth and Mastodon read to verify identity.
 * The repository link is a project, not an identity, so it deliberately does
 * not carry it.
 */

// "73" is the operator's sign-off: best regards. Encoded here rather than
// typed, so it is whatever the alphabet says it is.
const SIGN_OFF = '73'
const signOff = prettify(encode(SIGN_OFF))

const t = useTranslations(Astro)
const { groups: NAV_GROUPS } = siteNav(t)

/** The project row: engraved plate labels, each a 32px row, 44px under a finger (A-12). */
const projectLink =
  'mf-engraved inline-flex min-h-8 items-center hover:text-ink pointer-coarse:min-h-11'
---

<footer class="mt-24 border-t border-line bg-panel/60">
  <div
    class="mx-auto grid max-w-7xl gap-12 px-5 py-14 sm:px-6 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]"
  >
    <div class="max-w-sm">
      <a
        href={t.href('/')}
        class="inline-flex items-center rounded-control pointer-coarse:min-h-11"
        aria-label={t('footer.home', { site: SITE.name })}
      >
        <Logo size={32} decorative />
      </a>
      <p class="mt-5 text-sm leading-relaxed text-muted">
        <Rich
          nodes={t.rich('footer.builtBy', { name: AUTHOR.name })}
          tags={{
            author: {
              href: AUTHOR.url,
              rel: 'me',
              class:
                'text-ink underline decoration-signal/50 decoration-1 underline-offset-4 hover:decoration-signal',
            },
          }}
        />
      </p>
      <p class="mf-engraved mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <span class="font-mono tracking-code text-signal-dim" aria-hidden="true">{signOff}</span>
        <span>{t('footer.signOff', { code: SIGN_OFF })}</span>
      </p>
    </div>

    <nav aria-label={t('footer.allPages')} class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4">
      {
        NAV_GROUPS.map((group) => (
          <div>
            <p class="mf-engraved text-brass">{group.title}</p>
            <ul class="mt-2">
              {group.links.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class="inline-flex min-h-8 items-center text-[15px] text-ink hover:text-signal pointer-coarse:min-h-11 pointer-coarse:min-w-11"
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="border-t border-line">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-6"
    >
      <nav
        aria-label={t('footer.projectLinks')}
        class="flex flex-wrap items-center gap-x-6 gap-y-1"
      >
        <a href={t.href('/settings/')} class={projectLink}>{t('footer.settings')}</a>
        <a href={t.href('/privacy/')} class={projectLink}>{t('footer.privacy')}</a>
        <a href={SITE.repo} rel="noopener" class={projectLink}>{t('footer.source')}</a>
        <a href={AUTHOR_X_URL} rel="me noopener" class={projectLink}>@{AUTHOR.x}</a>
        <a href={AUTHOR.url} rel="me noopener" class={projectLink}>
          {new URL(AUTHOR.url).host}
        </a>
      </nav>
      <LocaleSwitcher />
      <p class="mf-engraved">{t('footer.promises')}</p>
    </div>
  </div>
</footer>
