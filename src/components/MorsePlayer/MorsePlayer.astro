---
import { prettify } from '../../engine/morseEncoder'
import { buildTimeline, timelineDuration } from '../../engine/timingEngine'

/**
 * The Morse player, with no framework behind it.
 *
 * The React version shipped 179 KB of runtime for a play button, three toggles
 * and a slider. This renders the same control as static HTML and wires it with
 * about five kilobytes of the audio engine — which the site already loads
 * everywhere it makes sound.
 *
 * The code and its translation are in the served HTML, so the page is readable
 * with JavaScript off. The React version rendered nothing at all until it
 * hydrated, which was the wrong default for pages whose whole job is to be
 * found and read.
 */
export interface Props {
  morse: string
  label?: string
  initialWpm?: number
  /** Show the signal lamp. */
  flash?: boolean
  /** Hide the duration readout, where space is tight. */
  compact?: boolean
}

const { morse, label, initialWpm = 15, flash = true, compact = false } = Astro.props

const seconds = (timelineDuration(buildTimeline(morse, { wpm: initialWpm })) / 1000).toFixed(1)
const spoken = [...morse]
  .map((mark) => (mark === '.' ? 'dot' : mark === '-' ? 'dash' : 'break'))
  .join(' ')
---

<div class="rounded-xl border border-line bg-panel p-5" data-morse-player data-morse={morse}>
  {label && <div class="mb-1 font-mono text-[10px] tracking-[0.18em] text-muted">{label}</div>}

  {
    /*
    The prettified glyphs are for the eye; the spoken form is for a screen
    reader. An aria-label on the paragraph would have done neither — it is a
    generic element, so most screen readers ignore the label and read the
    glyphs instead.
  */
  }
  <p class="font-mono text-lg break-all text-cyan">
    <span class="sr-only">{spoken}</span>
    <span aria-hidden="true">{prettify(morse)}</span>
  </p>

  {
    /*
    The lamp is aria-hidden: the code is already in the DOM above, and a
    screen reader announcing every flash would be unusable.
  */
  }
  <div
    aria-hidden="true"
    data-part="lamp-box"
    hidden={!flash}
    class="mt-4 h-24 rounded-lg border"
    style="border-color: var(--color-line); background: var(--color-void)"
  >
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-3">
    <button
      type="button"
      data-part="play"
      class="rounded-lg px-5 py-2.5 font-mono text-xs tracking-[0.14em]"
      style="background: var(--color-signal); color: var(--color-void)">▶ PLAY</button
    >

    <button
      type="button"
      data-part="sound"
      aria-pressed="true"
      class="rounded-lg border px-3 py-2.5 font-mono text-xs tracking-[0.14em]"
      style="border-color: var(--color-signal); color: var(--color-signal)">SOUND</button
    >

    <button
      type="button"
      data-part="buzz"
      aria-pressed="false"
      hidden
      class="rounded-lg border px-3 py-2.5 font-mono text-xs tracking-[0.14em]"
      style="border-color: var(--color-line); color: var(--color-muted)">BUZZ</button
    >

    <button
      type="button"
      data-part="lamp"
      aria-pressed={flash ? 'true' : 'false'}
      class="rounded-lg border px-3 py-2.5 font-mono text-xs tracking-[0.14em]"
      style={flash
        ? 'border-color: var(--color-cyan); color: var(--color-cyan)'
        : 'border-color: var(--color-line); color: var(--color-muted)'}>LAMP</button
    >

    {
      !compact && (
        <span data-part="duration" class="font-mono text-[11px] tracking-[0.12em] text-muted">
          ~{seconds}s
        </span>
      )
    }
  </div>

  <label class="mt-4 flex items-center gap-3">
    <span class="font-mono text-[10px] tracking-[0.16em] text-muted">SPEED</span>
    <input
      type="range"
      data-part="speed"
      min="5"
      max="40"
      value={initialWpm}
      class="flex-1 accent-[var(--color-signal)]"
      aria-label="Speed in words per minute"
    />
    <span data-part="wpm" class="w-16 text-right font-mono text-xs text-signal">
      {initialWpm} WPM
    </span>
  </label>
</div>

<script>
  import { mountAllPlayers } from './player'

  mountAllPlayers()
  // Astro's client router swaps the DOM without a reload, so any player that
  // arrives with a new page has to be wired too.
  document.addEventListener('astro:page-load', () => mountAllPlayers())
</script>
