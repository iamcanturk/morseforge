---
import '../../styles/pkg-i.css'
import { prettify } from '../../engine/morseEncoder'
import { spokenCode } from '../../engine/spokenCode'
import { buildTimeline, timelineDuration } from '../../engine/timingEngine'
import { WPM_RANGE } from '../../storage/settings'

/**
 * The Morse player, with no framework behind it.
 *
 * The React version shipped 179 KB of runtime for a play button, three toggles
 * and a slider. This renders the same control as static HTML and wires it with
 * about five kilobytes of the audio engine — which the site already loads
 * everywhere it makes sound.
 *
 * The code and its translation are in the served HTML, so the page is readable
 * with JavaScript off. The React version rendered nothing at all until it
 * hydrated, which was the wrong default for pages whose whole job is to be
 * found and read.
 *
 * Drawn as an instrument: a CRT strip carrying the code and a round signal
 * lamp behind a brass bezel, with the controls on the panel below. Every
 * state (lit, pressed, playing) is an attribute or a class that player.ts
 * flips; no colour is set inline.
 */
export interface Props {
  morse: string
  label?: string
  initialWpm?: number
  /** Show the signal lamp. */
  flash?: boolean
  /** Hide the duration readout, where space is tight. */
  compact?: boolean
}

const { morse, label, initialWpm = 15, flash = true, compact = false } = Astro.props

const seconds = (timelineDuration(buildTimeline(morse, { wpm: initialWpm })) / 1000).toFixed(1)
const spoken = spokenCode(morse)
---

<div class="mf-panel p-3 sm:p-4" data-morse-player data-morse={morse}>
  <div class="mf-screen flex items-center gap-5 px-5 py-5 sm:px-6">
    <div class="relative min-w-0 flex-1">
      {label && <p class="mf-engraved">{label}</p>}
      {
        /*
        The prettified glyphs are for the eye; the spoken form is for a screen
        reader. An aria-label on the paragraph would have done neither — it is a
        generic element, so most screen readers ignore the label and read the
        glyphs instead.
      */
      }
      <p class="pi-code mt-2 font-mono text-xl text-signal sm:text-2xl">
        <span class="sr-only">{spoken}</span>
        <span aria-hidden="true">{prettify(morse)}</span>
      </p>
    </div>
    {
      /*
      The lamp is aria-hidden: the code is already in the DOM above, and a
      screen reader announcing every flash would be unusable.
    */
    }
    <div
      aria-hidden="true"
      data-part="lamp-box"
      data-on="false"
      hidden={!flash}
      class="pi-bulb pi-bulb-lg"
    >
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2 px-1 sm:gap-3">
    <button type="button" data-part="play" class="mf-btn mf-btn-audio min-w-28">
      <span
        class="mf-lamp"
        data-tone="cyan"
        data-on="false"
        data-part="play-lamp"
        aria-hidden="true"></span>
      <span data-part="play-label">Play</span>
    </button>

    <button
      type="button"
      data-part="sound"
      aria-pressed="true"
      class="mf-btn mf-btn-secondary mf-btn-sm pi-toggle"
    >
      <span class="mf-lamp" data-on="true" aria-hidden="true"></span>
      Sound
    </button>

    <button
      type="button"
      data-part="buzz"
      aria-pressed="false"
      hidden
      class="mf-btn mf-btn-secondary mf-btn-sm pi-toggle"
    >
      <span class="mf-lamp" data-tone="amber" data-on="false" aria-hidden="true"></span>
      Buzz
    </button>

    <button
      type="button"
      data-part="lamp"
      aria-pressed={flash ? 'true' : 'false'}
      class="mf-btn mf-btn-secondary mf-btn-sm pi-toggle"
    >
      <span class="mf-lamp" data-tone="cyan" data-on={flash ? 'true' : 'false'} aria-hidden="true"
      ></span>
      Lamp
    </button>

    {
      !compact && (
        <span class="ml-auto font-mono text-control text-muted tabular-nums">
          <span class="sr-only">Length </span>
          <span data-part="duration">~{seconds}s</span>
        </span>
      )
    }
  </div>

  <label class="mt-4 flex items-center gap-3 px-1">
    <span class="mf-engraved">Speed</span>
    <input
      type="range"
      data-part="speed"
      min={WPM_RANGE.min}
      max={WPM_RANGE.max}
      value={initialWpm}
      class="mf-range flex-1"
      aria-label="Speed in words per minute"
    />
    <span data-part="wpm" class="w-16 text-right font-mono text-control text-signal tabular-nums">
      {initialWpm} WPM
    </span>
  </label>
</div>

<script>
  import { mountAllPlayers } from './player'

  mountAllPlayers()
  // Astro's client router swaps the DOM without a reload, so any player that
  // arrives with a new page has to be wired too.
  document.addEventListener('astro:page-load', () => mountAllPlayers())
</script>
