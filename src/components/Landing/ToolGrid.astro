---
/**
 * Section 6, "Pick an instrument" (TASK-001 §5.2): every free tool, from the
 * registry's `LANDING.tools`.
 *
 * The three that people come back to and send to friends — the key, the
 * challenges, the secret message — are featured with a small screen each; the
 * rest are link cards. A tool whose page does not exist yet (the secret
 * message, until its package lands) is left out rather than shipped as a 404,
 * and the tree takes its featured slot.
 */
import { FACTS } from '../../config/facts'
import { LANDING, type LandingTool } from '../../config/landing'
import { GROUP_LABELS, findPage, getPage } from '../../config/pages'
import { MORSE_ALPHABET } from '../../data/morseAlphabet'
import { hasPage } from '../ui/siteNav'

const tools = LANDING.tools.items.filter((tool) => hasPage(tool.href))

/** The challenge card's own links, labelled from the registry. */
const challengeLinks = ['/challenge/', '/daily/', '/games/signal-defender/', '/games/morse-runner/']
  .filter((path) => hasPage(path))
  .map((path) => ({ href: path, label: getPage(path).navLabel }))

const FEATURED_ORDER = ['/telegraph/', '/challenge/', '/message/', '/tree/']
const featured = FEATURED_ORDER.map((href) => tools.find((tool) => tool.href === href))
  .filter((tool): tool is LandingTool => tool !== undefined)
  .slice(0, 3)
const rest = tools.filter((tool) => !featured.includes(tool))

const groupLabel = (href: string) => {
  const group = findPage(href)?.group
  return group && group !== 'home' && group !== 'internal' ? GROUP_LABELS[group] : 'Tool'
}

/** A keyed trace for the telegraph card's screen: C, then Q, from the alphabet. */
function trace(characters: readonly string[]): string {
  const unit = 5
  let x = 6
  let d = `M0 30 H${x}`
  for (const character of characters) {
    for (const element of MORSE_ALPHABET[character] ?? '') {
      const width = element === '.' ? unit : unit * 3
      d += ` V12 H${x + width} V30`
      x += width + unit
      d += ` H${x}`
    }
    x += unit * 2
    d += ` H${x}`
  }
  return `${d} H${x + 6}`
}

const keyTrace = trace(['C', 'Q'])
---

<section class="py-16 md:py-24" aria-labelledby="tools-heading">
  <div class="mx-auto max-w-7xl px-5 sm:px-6">
    <p class="mf-engraved text-brass">Pick an instrument</p>
    <h2 id="tools-heading" class="mt-3 font-display text-h2 font-bold text-ink">
      {LANDING.tools.heading}
    </h2>

    <ul class="mt-8 grid gap-4 lg:grid-cols-3">
      {
        featured.map((tool) =>
          tool.href === '/challenge/' ? (
            <li class="mf-card h-full">
              <span class="flex items-center gap-2 mf-engraved">
                <span class="mf-lamp" data-tone="amber" aria-hidden="true" />
                {groupLabel(tool.href)}
              </span>{' '}
              <span
                class="mf-screen mf-screen-flush grid h-28 grid-cols-2 items-center px-5"
                aria-hidden="true"
              >
                <span class="relative z-[3] grid gap-1">
                  <span class="mf-engraved text-amber">Challenge</span>
                  <span class="font-mono text-readout text-signal tabular-nums">
                    {FACTS.challengeSeconds}s
                  </span>
                </span>
                <span class="relative z-[3] grid gap-1">
                  <span class="mf-engraved text-amber">Today's wire</span>
                  <span class="font-mono text-readout text-signal tabular-nums">
                    {FACTS.dailyLines}
                    <span class="text-label text-muted"> lines</span>
                  </span>
                </span>
              </span>{' '}
              <h3 class="font-display text-h3 font-bold text-ink">{tool.title}</h3>
              <p class="text-sm leading-relaxed text-muted">{tool.blurb}</p>
              {/* Two by two on a laptop, so this card's four links no longer
                  set the row's height and leave its neighbours half empty (V-15). */}
              <span class="mt-auto flex flex-wrap gap-2 lg:grid lg:grid-cols-2">
                {challengeLinks.map((link, index) => (
                  <a
                    href={link.href}
                    class:list={[
                      'mf-btn mf-btn-sm lg:px-2.5 lg:py-1.5 lg:text-center lg:leading-tight lg:whitespace-normal',
                      index === 0 ? 'mf-btn-amber' : 'mf-btn-secondary',
                    ]}
                  >
                    {link.label}
                  </a>
                ))}
              </span>
            </li>
          ) : (
            <li>
              <a href={tool.href} class="mf-card h-full">
                <span class="flex items-center gap-2 mf-engraved">
                  <span class="mf-lamp" aria-hidden="true" />
                  {groupLabel(tool.href)}
                </span>{' '}
                <span
                  class="mf-screen mf-screen-flush grid h-28 place-items-center"
                  aria-hidden="true"
                >
                  {tool.href === '/telegraph/' ? (
                    <svg viewBox="0 0 150 40" class="relative z-[3] h-10 w-auto text-signal">
                      <path
                        d={keyTrace}
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linejoin="round"
                      />
                    </svg>
                  ) : tool.href === '/message/' ? (
                    <svg viewBox="0 0 120 60" class="relative z-[3] h-14 w-auto text-cyan">
                      <rect
                        x="20"
                        y="10"
                        width="80"
                        height="44"
                        rx="4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                      />
                      <path
                        d="M20 14 L60 38 L100 14"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linejoin="round"
                      />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 120 60" class="relative z-[3] h-14 w-auto text-signal">
                      <path
                        d="M60 8 L30 28 M60 8 L90 28 M30 28 L16 50 M30 28 L44 50 M90 28 L76 50 M90 28 L104 50"
                        stroke="currentColor"
                        stroke-opacity="0.5"
                        stroke-width="2"
                      />
                      <circle cx="60" cy="8" r="4" fill="currentColor" />
                      {[
                        [30, 28],
                        [90, 28],
                        [16, 50],
                        [44, 50],
                        [76, 50],
                        [104, 50],
                      ].map(([cx, cy]) => (
                        <circle
                          cx={cx}
                          cy={cy}
                          r="5.5"
                          fill="var(--color-screen)"
                          stroke="currentColor"
                          stroke-width="2"
                        />
                      ))}
                    </svg>
                  )}
                </span>{' '}
                <h3 class="font-display text-h3 font-bold text-ink">{tool.title}</h3>
                <p class="text-sm leading-relaxed text-muted">{tool.blurb}</p>
                <span class="mt-auto mf-engraved text-signal">Open →</span>
              </a>
            </li>
          ),
        )
      }
    </ul>

    <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        rest.map((tool) => (
          <li>
            <a href={tool.href} class="mf-card h-full">
              <span class="flex items-center gap-2 mf-engraved">
                <span class="mf-lamp" aria-hidden="true" />
                {groupLabel(tool.href)}
              </span>{' '}
              <h3 class="font-display text-h3 font-bold text-ink">{tool.title}</h3>
              <p class="text-sm leading-relaxed text-muted">{tool.blurb}</p>
              <span class="mt-auto mf-engraved text-signal">Open →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
