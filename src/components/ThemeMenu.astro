---
import { THEME_CHOICE_NAMES, THEME_CONTROL_SCRIPT } from './ui/themeControl'

/**
 * The header's theme control (DEC-040): one button, not a three-segment
 * toggle. It shows the theme in force (a moon or a sun, from
 * `html[data-theme]`, which the blocking script in BaseLayout sets before first
 * paint, so the icon is never wrong for a frame) and opens System, Dark and
 * Light as `menuitemradio`s with a check on the current choice.
 *
 * A native `<details>`, like the header's other menus: it opens without
 * JavaScript, `name="mf-menu"` closes the others, and the header's script
 * closes it on Escape (returning focus to the button) and on an outside click.
 * ui/themeControl.ts adds the rest: choosing, focus into the menu on open, and
 * arrow keys between the items. It also renames the button with the state,
 * "Colour theme: System, dark now" (AI-3); the plain name below is only what
 * a page without JavaScript keeps.
 */
const options = (['system', 'dark', 'light'] as const).map((value) => ({
  value,
  label: THEME_CHOICE_NAMES[value],
}))
---

<details name="mf-menu" class="mf-theme-menu group relative" data-menu data-theme-menu>
  <summary
    class="mf-summary mf-icon-btn group-open:text-ink"
    aria-label="Colour theme"
    aria-haspopup="menu"
    title="Colour theme"
  >
    <svg
      class="mf-theme-icon-dark"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
    </svg>
    <svg
      class="mf-theme-icon-light"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path
        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
      ></path>
    </svg>
  </summary>

  <div class="mf-popover" role="menu" aria-label="Colour theme">
    {
      options.map(({ value, label }) => (
        <button
          type="button"
          role="menuitemradio"
          aria-checked={value === 'system' ? 'true' : 'false'}
          tabindex="-1"
          data-theme-option={value}
          class="mf-popover-item"
        >
          {value === 'system' && (
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <rect x="2" y="3" width="20" height="14" rx="2" />
              <path d="M8 21h8M12 17v4" />
            </svg>
          )}
          {value === 'dark' && (
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
            </svg>
          )}
          {value === 'light' && (
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
          )}
          <span class="flex-1">{label}</span>
          <svg
            class="mf-popover-check"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5" />
          </svg>
        </button>
      ))
    }
  </div>
</details>

<script is:inline set:html={THEME_CONTROL_SCRIPT} />
