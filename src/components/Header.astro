---
import { Logo, LogoMark } from './brand/Logo'
import ThemeMenu from './ThemeMenu.astro'
import { MENU_TILES, NAV_GROUPS, PHONE_GROUPS, PRIMARY_NAV, isCurrent } from './ui/siteNav'
import { SITE } from '../config/site'
import { SKILLS } from '../game/mastery'
import { LESSON_STAGES } from '../game/nextAction'
import { STREAK_GRACE_DAYS } from '../game/progression'
import { PROGRESS_KEY } from '../storage/progress'
import { STATS_KEY } from '../storage/stats'

/**
 * Site header: one 56px row at every width (DEC-040).
 *
 * Logo, then the nav left-aligned after it (centring it between two clusters
 * of changing width made it drift), then one cluster on the right with one
 * rhythm: 40 px hit areas 4 px apart (44 px under a finger), the chip 8 px
 * before them. Only what a learner uses from every page is in the bar: the
 * progress chip, when it has something to say; one theme button with a menu;
 * Settings, at every width (DEC-043). GitHub is in the footer and at the
 * bottom of the phone menu. On a phone the bar is logo · chip · theme ·
 * settings · menu; below 380 px, while the chip shows, the logo drops to the
 * mark so all five fit (a 320 px window included).
 *
 * Four destinations in the bar — Learn, Practice, Telegraph, Daily — and the
 * rest behind "All tools". Telegraph and Daily used to be buried in the menu
 * although they are the most fun and the most shareable things here. On a
 * phone the menu trigger sits in the same row, rather than as a second row
 * that doubled the sticky header's height and took it from the key.
 *
 * Both menus are native `<details>`, so they open without JavaScript, are
 * keyboard operable for free, and every link inside stays in the HTML for a
 * crawler. That matters: the nav is also the internal linking, and a menu
 * built from JavaScript would hide two thirds of the site from a bot. `name`
 * makes the two mutually exclusive.
 *
 * `Logo` is a React component with no client directive, so Astro renders it to
 * static HTML and ships zero JavaScript for it.
 */
const pathname = Astro.url.pathname
const current = (href: string) => (isCurrent(href, pathname) ? 'page' : undefined)
---

<header class="mf-header">
  <div class="mx-auto flex h-14 max-w-7xl items-center gap-2 px-4 sm:px-6">
    {
      /* A 44 px hit area round an 18–20 px lockup: the padding is the target,
        the negative margin keeps the lockup where it was. */
    }
    <a
      href="/"
      class="-ml-2 flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-control px-2"
      aria-label={`${SITE.name} home`}
    >
      {
        /* The header's optical size of the lockup: 18 px of mark on a phone,
          so the full lockup fits beside the controls at 360 px; 20 above. */
      }
      <Logo size={18} compact decorative className="mf-logo-full sm:hidden" />
      <LogoMark size={18} decorative className="mf-logo-mark" />
      <Logo size={20} compact decorative className="hidden sm:block" />
    </a>

    <nav aria-label="Main" class="ml-10 hidden items-center gap-7 lg:flex">
      {
        PRIMARY_NAV.map(({ href, label }) => (
          <a href={href} aria-current={current(href)} class="mf-nav-link">
            {label}
          </a>
        ))
      }

      <details name="mf-menu" class="group" data-menu>
        <summary class="mf-summary mf-nav-link gap-1.5 text-muted hover:text-ink">
          All tools
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
            class="transition-transform duration-150 group-open:rotate-180"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>

        <div class="mf-menu-panel px-6 pt-2">
          <div class="mf-panel mx-auto grid max-w-5xl grid-cols-4 gap-8 p-7 shadow-2xl">
            {
              NAV_GROUPS.map((group) => (
                <div>
                  <p class="mf-engraved text-brass">{group.title}</p>
                  <ul class="mt-3 space-y-1">
                    {group.links.map(({ href, label, hint }) => (
                      <li>
                        <a href={href} aria-current={current(href)} class="mf-menu-link">
                          <span class="mf-menu-link-label">{label}</span>{' '}
                          <span class="mf-menu-link-hint">{hint}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </details>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1">
      {
        /* Progress chip (DEC-008, Q3a). Rendered hidden and filled by the few
          lines below from the stats and progress records. With no record, or
          one it cannot read, it stays hidden: a fresh visitor sees nothing,
          and a malformed record never becomes a wrong number in the header.

          It never shows empty. With a streak it is the amber lamp, lit once
          you have practised today, and the streak as "5d"; the label and the
          arrow join from sm up. Without a streak it is the label, at every
          width. Its accessible name starts with exactly what it shows, so a
          voice user can say what they see (A-17). */
      }
      <a href="/learn/" class="mf-chip ml-2 mr-1 sm:mr-2" hidden data-progress-chip>
        <span class="mf-lamp" data-tone="amber" data-chip-lamp aria-hidden="true"></span>
        <span data-chip-streak class="mf-chip-streak"></span>
        <span data-chip-label class="mf-chip-label">Continue</span>
        <svg
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
          class="hidden text-signal sm:block"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
      <script
        is:inline
        define:vars={{
          statsKey: STATS_KEY,
          progressKey: PROGRESS_KEY,
          graceDays: STREAK_GRACE_DAYS,
          stages: LESSON_STAGES,
          skills: SKILLS,
        }}
      >
        // Envelope `{ version, data }`, as src/storage/store.ts writes it.
        // Field by field and type by type, so an older or newer record shape
        // reads as "nothing to show" rather than as an error or a NaN.
        const read = (key) => {
          const record = JSON.parse(localStorage.getItem(key) ?? 'null')
          const data = typeof record?.version === 'number' ? record.data : null
          return data && typeof data === 'object' ? data : null
        }
        const day = (key) => {
          const [y, m, d] = key.split('-').map(Number)
          return Date.UTC(y, m - 1, d)
        }

        // Run now, and again whenever the records may have changed under the
        // page: back from the cache, back to the tab, or written by another
        // tab. Same-tab practice is caught on the next page load.
        const wide = window.matchMedia('(min-width: 40rem)')
        const render = () => {
          const chip = document.querySelector('[data-progress-chip]')
          if (!chip) return
          try {
            const now = new Date()
            const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate())

            // The displayed streak, as game/progression.ts currentStreak computes it.
            const streak = read(statsKey)?.streak
            let days = 0
            let lit = false
            if (
              Number.isInteger(streak?.current) &&
              streak.current > 0 &&
              /^\d{4}-\d{2}-\d{2}$/.test(streak?.lastActiveDay ?? '')
            ) {
              const gap = Math.round((today - day(streak.lastActiveDay)) / 86400000)
              if (gap <= graceDays + 1) days = streak.current
              lit = days > 0 && gap <= 0
            }

            const characters = read(progressKey)?.characters ?? {}
            const seen = stages.flat().some((c) => characters[c]?.seen === true)
            // game/nextAction.ts lessonStagesDone: stages count as a run from the
            // first, and a stage is done once each of its characters has a
            // correct answer in some skill (mastery level 2; a test pins that).
            const passed = (c) => skills.some((s) => characters[c]?.skills?.[s]?.correct > 0)
            const unfinished = stages.findIndex((stage) => !stage.every(passed))

            if (days === 0 && !seen) {
              chip.hidden = true
              return
            }

            // The course first, digits included, then practice once every stage is done.
            let href = unfinished === -1 ? '/practice/' : '/learn/'
            let label = 'Continue'
            if (href === location.pathname) {
              href = '/stats/'
              label = 'Progress'
            }
            const lamp = chip.querySelector('[data-chip-lamp]')
            const count = chip.querySelector('[data-chip-streak]')
            const labelEl = chip.querySelector('[data-chip-label]')
            chip.href = href
            labelEl.textContent = label
            // With no number to show, the label is the content: never hide it.
            chip.dataset.streak = days > 0 ? 'true' : 'false'
            count.textContent = days > 0 ? `${days}d` : ''
            count.hidden = days === 0
            lamp.hidden = days === 0
            lamp.dataset.on = String(lit)
            // The name starts with what a sighted user reads, word for word
            // ("5d" on a phone, "5d Continue" from sm up), then says it in full.
            const shown = wide.matches || days === 0
            const streakText = `${days}-day streak${lit ? ', practised today' : ''}`
            const parts =
              days > 0 ? [shown ? `${days}d ${label}` : `${days}d`, streakText] : [label]
            if (days > 0 && !shown) parts.splice(1, 0, label)
            chip.setAttribute('aria-label', parts.join(', '))
            chip.title = days > 0 ? streakText : ''
            chip.hidden = false
          } catch {
            // No storage, or something unreadable in it. The chip stays as it was.
          }
        }
        render()
        window.addEventListener('pageshow', render)
        window.addEventListener('storage', render)
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') render()
        })
        // The visible text changes at sm, and the name follows it.
        wide.addEventListener('change', render)
      </script>

      <ThemeMenu />

      <a
        href="/settings/"
        aria-label="Settings"
        aria-current={current('/settings/')}
        title="Settings"
        class="mf-icon-btn"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="3"></circle>
          <path
            d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"
          ></path>
        </svg>
      </a>

      {
        /* The phone menu: the trigger in the top row, the panel hanging from
          the header's bottom edge and capped to the screen. A sticky element
          taller than the viewport stops sticking, so the panel scrolls inside
          itself instead of making the header that tall.

          The six tiles are the destinations a phone needs most, with their
          hints. The lists under them are everything else, once: no page the
          tiles already link appears again (V-13), so the panel is a little
          over one screen rather than two. Settings is the gear in the bar. */
      }
      <details name="mf-menu" class="group lg:hidden" data-menu>
        <summary class="mf-summary mf-icon-btn text-ink">
          <span class="sr-only">Menu</span>
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
            class="group-open:hidden"
          >
            <path d="M4 7h16M4 12h10M4 17h16"></path>
          </svg>
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
            class="hidden group-open:block"
          >
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </summary>

        <nav
          aria-label="Main"
          class="mf-menu-panel max-h-[calc(100svh-3.5rem)] overflow-y-auto overscroll-contain border-b border-line-strong bg-panel shadow-2xl"
        >
          <div class="mx-auto max-w-3xl px-4 pt-4 pb-6 sm:px-6">
            <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3">
              {
                MENU_TILES.map(({ href, label, hint }) => (
                  <li>
                    <a href={href} aria-current={current(href)} class="mf-menu-tile">
                      <span class="mf-menu-link-label">{label}</span>{' '}
                      <span class="mf-menu-link-hint">{hint}</span>
                    </a>
                  </li>
                ))
              }
            </ul>

            <div class="mt-6 grid grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-4">
              {
                PHONE_GROUPS.map((group) => (
                  <div>
                    <p class="mf-engraved text-brass">{group.title}</p>
                    <ul class="mt-1.5">
                      {group.links.map(({ href, label }) => (
                        <li>
                          <a href={href} aria-current={current(href)} class="mf-menu-row">
                            {label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>

            <div class="mt-5 border-t border-line pt-3">
              <a
                href={SITE.repo}
                rel="noopener"
                class="mf-btn mf-btn-ghost mf-btn-sm -ml-3 min-h-11">Source on GitHub</a
              >
            </div>
          </div>
        </nav>
      </details>
    </div>
  </div>

  <script is:inline>
    // A native <details> stays open after you follow a link back, and does
    // not close on an outside click, on Escape, or when focus leaves it. This
    // is the whole behaviour the element is missing; it is not worth a
    // framework. In a block, so its names stay out of the page's globals.
    {
      const closeOutside = (target) => {
        for (const menu of document.querySelectorAll('[data-menu][open]')) {
          if (!menu.contains(target)) menu.removeAttribute('open')
        }
      }
      document.addEventListener('click', (event) => closeOutside(event.target))
      // Tabbing out of a menu closes it (A-05): an open panel would otherwise
      // cover the control that now has focus. Focus is not moved.
      document.addEventListener('focusin', (event) => closeOutside(event.target))
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return
        for (const menu of document.querySelectorAll('[data-menu][open]')) {
          menu.removeAttribute('open')
          menu.querySelector('summary')?.focus()
        }
      })
      window.addEventListener('pageshow', () => {
        for (const menu of document.querySelectorAll('[data-menu][open]')) {
          menu.removeAttribute('open')
        }
      })
    }
  </script>
</header>
