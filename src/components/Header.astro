---
import { Logo } from './brand/Logo'
import ThemeToggle from './ThemeToggle.astro'
import { AUTHOR, AUTHOR_GITHUB_URL, AUTHOR_X_URL, SITE } from '../config/site'

/**
 * Site header.
 *
 * Three destinations in the bar and everything else behind one disclosure.
 * The previous version put all nine links in the bar under tiny group labels,
 * which turned the header into a wall of 9px type — a list to be scanned rather
 * than a route to be chosen.
 *
 * The disclosure is a native `<details>`, so it opens without JavaScript, is
 * keyboard operable for free, and every link inside stays in the HTML for a
 * crawler. That last part matters: the nav is also the internal linking, and a
 * menu built from JavaScript would hide two thirds of the site from a bot.
 *
 * `Logo` is a React component with no client directive, so Astro renders it to
 * static HTML and ships zero JavaScript for it.
 */
const primary = [
  { href: '/learn/', label: 'Learn' },
  { href: '/practice/', label: 'Practice' },
  { href: '/morse-code-translator/', label: 'Translator' },
  { href: '/stats/', label: 'Progress' },
]

const more = [
  {
    title: 'Learn',
    links: [
      { href: '/learn/', label: 'Guided lessons', hint: 'See it, hear it, send it' },
      {
        href: '/learn-morse-code-in-7-days/',
        label: '7-day plan',
        hint: 'The whole course, written out',
      },
      { href: '/tree/', label: 'The Morse tree', hint: 'Why each letter has its code' },
    ],
  },
  {
    title: 'Practise',
    links: [
      { href: '/practice/', label: 'Practice', hint: 'Listen, read or send' },
      { href: '/copy/', label: 'Copy practice', hint: 'Whole lines, graded per character' },
      { href: '/daily/', label: 'Daily challenge', hint: 'The same one for everyone' },
      { href: '/challenge/', label: '60-second challenge', hint: 'How many can you decode?' },
      { href: '/telegraph/', label: 'Telegraph key', hint: 'Send freely and read it back' },
      {
        href: '/games/signal-defender/',
        label: 'Signal Defender',
        hint: 'Copy them before they land',
      },
      { href: '/games/morse-runner/', label: 'Morse Runner', hint: 'Send before you arrive' },
    ],
  },
  {
    title: 'Look up',
    links: [
      { href: '/morse-code-translator/', label: 'Translator', hint: 'Text to Morse and back' },
      { href: '/morse-code-alphabet/', label: 'Alphabet', hint: 'Every character, playable' },
      { href: '/words/', label: 'Words in Morse', hint: 'SOS, CQ, I love you…' },
      { href: '/blog/', label: 'Notes', hint: 'How to learn it properly' },
      { href: '/privacy/', label: 'Privacy', hint: 'No cookies, and why' },
      { href: '/stats/', label: 'Your progress', hint: 'Level, streak, achievements' },
    ],
  },
]

const current = Astro.url.pathname
const isCurrent = (href: string) => current === href
---

<header
  class="sticky top-0 z-40 border-b border-line backdrop-blur"
  style="background: color-mix(in srgb, var(--color-void) 88%, transparent)"
>
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex items-center justify-between gap-4 py-3">
      <div class="flex items-center gap-7">
        <a href="/" class="shrink-0" aria-label="MorseForge home">
          <Logo size={24} />
        </a>

        <nav aria-label="Main" class="hidden items-center gap-6 lg:flex">
          {
            primary.map(({ href, label }) => (
              <a
                href={href}
                aria-current={isCurrent(href) ? 'page' : undefined}
                class="text-sm transition-colors hover:text-signal"
                style={isCurrent(href) ? 'color: var(--color-signal)' : 'color: var(--color-ink)'}
              >
                {label}
              </a>
            ))
          }

          <details class="group relative" data-menu>
            <summary
              class="flex cursor-pointer list-none items-center gap-1 text-sm text-muted transition-colors hover:text-signal [&::-webkit-details-marker]:hidden"
            >
              Everything
              <svg
                width="11"
                height="11"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                aria-hidden="true"
                class="transition-transform group-open:rotate-180"
              >
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </summary>

            <div
              class="absolute top-full left-0 z-50 mt-3 grid w-[34rem] grid-cols-3 gap-5 rounded-xl border border-line p-5 shadow-2xl"
              style="background: var(--color-panel)"
            >
              {
                more.map((group) => (
                  <div>
                    <span class="block font-mono text-[9px] tracking-[0.18em] text-signal-dim">
                      {group.title.toUpperCase()}
                    </span>
                    <ul class="mt-2.5 space-y-2.5">
                      {group.links.map(({ href, label, hint }) => (
                        <li>
                          <a
                            href={href}
                            aria-current={isCurrent(href) ? 'page' : undefined}
                            class="block group/link"
                          >
                            <span
                              class="block text-[13px] transition-colors group-hover/link:text-signal"
                              style={
                                isCurrent(href)
                                  ? 'color: var(--color-signal)'
                                  : 'color: var(--color-ink)'
                              }
                            >
                              {label}
                            </span>
                            <span class="mt-0.5 block text-[11px] leading-snug text-muted">
                              {hint}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
          </details>
        </nav>
      </div>

      {
        /* Author credit lives in the header as well as the footer: on a long
          content page the footer is a scroll away and is never seen. */
      }
      <div class="flex shrink-0 items-center gap-3">
        <a
          href={AUTHOR.url}
          rel="me"
          class="hidden text-xs whitespace-nowrap text-muted transition-colors hover:text-signal md:block"
          >by {AUTHOR.name}</a
        >

        <span class="hidden h-4 w-px bg-line md:block" aria-hidden="true"></span>

        <a
          href={SITE.repo}
          rel="noopener"
          aria-label="Source code on GitHub"
          title="Source on GitHub"
          class="text-muted transition-colors hover:text-signal"
        >
          <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
        </a>

        <a
          href={AUTHOR_X_URL}
          rel="me noopener"
          aria-label={`${AUTHOR.name} on X`}
          title={`@${AUTHOR.x} on X`}
          class="text-muted transition-colors hover:text-signal"
        >
          <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              d="M9.52 6.77 15.48 0h-1.41L8.89 5.88 4.75 0H0l6.25 8.9L0 16h1.41l5.46-6.21L11.25 16H16L9.52 6.77ZM7.59 8.98l-.63-.89L1.92 1.04h2.17l4.07 5.7.63.89 5.29 7.4h-2.17L7.59 8.98Z"
            ></path>
          </svg>
        </a>

        <a href={AUTHOR_GITHUB_URL} rel="me noopener" class="sr-only">{AUTHOR.name} on GitHub</a>

        <ThemeToggle />

        <a
          href="/settings/"
          aria-label="Settings"
          title="Settings"
          class="hidden text-muted transition-colors hover:text-signal lg:block"
        >
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="3"></circle>
            <path
              d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9v0a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    {
      /* The mobile menu.
        
        This was a sideways-scrolling strip, which measured badly: sixteen
        links, thirteen of them off-screen behind 1,462px of horizontal scroll
        with nothing to indicate there was anything to scroll to. Most of the
        site was unreachable on a phone unless you happened to swipe a row of
        text that did not look swipeable.
        
        A disclosure shows all of it, grouped the same way the desktop menu is.
        Native <details>, so it opens with no JavaScript and is keyboard
        operable for free, and every link stays in the HTML for a crawler. */
    }
    <details class="pb-3 lg:hidden" data-menu data-mobile-menu>
      <summary
        class="flex cursor-pointer list-none items-center justify-between rounded-lg border border-line px-4 py-2.5 text-sm text-ink [&::-webkit-details-marker]:hidden"
      >
        <span class="font-mono text-xs tracking-[0.16em]">MENU</span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
          class="text-muted transition-transform [details[open]_&]:rotate-180"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </summary>

      {
        /* Capped and scrollable. The header is sticky, and a sticky element
          taller than the viewport stops sticking — it scrolls away with the
          page and comes back in the wrong place. Open, this panel measured
          1,162px on an 812px screen. */
      }
      <nav aria-label="Main" class="mt-3 max-h-[62vh] space-y-5 overflow-y-auto overscroll-contain">
        {
          more.map((group) => (
            <div>
              <p class="font-mono text-[10px] tracking-[0.18em] text-signal-dim">
                {group.title.toUpperCase()}
              </p>
              <ul class="mt-1.5">
                {group.links.map(({ href, label, hint }) => (
                  <li>
                    <a
                      href={href}
                      aria-current={isCurrent(href) ? 'page' : undefined}
                      class="-mx-2 block rounded-lg px-2 py-2.5"
                      style={
                        isCurrent(href) ? 'color: var(--color-signal)' : 'color: var(--color-ink)'
                      }
                    >
                      <span class="block text-sm">{label}</span>
                      <span class="mt-0.5 block text-xs leading-snug text-muted">{hint}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <a
          href="/settings/"
          aria-current={isCurrent('/settings/') ? 'page' : undefined}
          class="-mx-2 block rounded-lg px-2 py-3 text-sm"
          style={isCurrent('/settings/')
            ? 'color: var(--color-signal)'
            : 'color: var(--color-muted)'}>Settings</a
        >
      </nav>
    </details>
  </div>

  <script is:inline>
    // A native <details> stays open after you follow a link back, and two open
    // at once would overlap. Neither is worth a framework — this is the whole
    // behaviour the element is missing.
    document.addEventListener('click', (event) => {
      for (const menu of document.querySelectorAll('[data-menu][open]')) {
        if (!menu.contains(event.target)) menu.removeAttribute('open')
      }
    })
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return
      for (const menu of document.querySelectorAll('[data-menu][open]')) {
        menu.removeAttribute('open')
        menu.querySelector('summary')?.focus()
      }
    })
  </script>
</header>
