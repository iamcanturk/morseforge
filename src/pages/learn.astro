---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageShell from '../components/PageShell.astro'
import Rich from '../components/I18n/Rich.astro'
import { LessonIsland, type NextStep } from '../components/Lesson/LessonScreen'
import { LESSON_ORDER, LESSON_STAGES, drillLength } from '../components/Lesson/lesson'
import { methodCopy } from '../components/Practice/copy'
import { hasPage } from '../components/ui/siteNav'
import { FACTS } from '../config/facts'
import { DEFAULT_METHOD } from '../data/methods'
import { prettify } from '../engine/morseEncoder'
import { MORSE_ALPHABET } from '../data/morseAlphabet'
import { breadcrumbs, webPage } from '../seo/schema'
import { useTranslations } from '../i18n/server'

const t = useTranslations(Astro)
const page = t.page('/learn/')
const plan = t.page('/learn-morse-code-in-7-days/')
const trail = t.trail(page.key)

const schema = [
  webPage({ path: page.path, name: page.h1, description: page.description }),
  breadcrumbs(trail),
]

/** Where the course-complete screen sends a finished learner, from the registry. */
const nextSteps: NextStep[] = ['/daily/', '/challenge/', '/copy/', '/message/']
  .filter((path) => hasPage(path))
  .map((path) => {
    const entry = t.page(path)
    return { href: entry.path, label: entry.navLabel, hint: entry.hint }
  })

const chartPost = '/blog/why-a-morse-code-chart-does-not-work/'
const howTo = '/how-to-learn-morse-code/'
const stageCount = LESSON_STAGES.length
const method = methodCopy(t, DEFAULT_METHOD)
const first = FACTS.planFirstDayCharacters
/**
 * "Stage 3: three elements, dot-first (S, U, R and W)", one per plan day. In
 * English the day's title is lower-cased to run on after the colon; another
 * language keeps its title as written, since its capitals may be grammar.
 */
const stageLines = t.curriculum.map((day, index) =>
  t('learnPage.stageLine', {
    stage: index + 1,
    title: t.isDefault ? `${day.title.charAt(0).toLowerCase()}${day.title.slice(1)}` : day.title,
    characters: t.list(day.characters),
  }),
)
const minDrill = Math.min(...LESSON_STAGES.map((_, index) => drillLength(index)))
---

<BaseLayout title={page.title} description={page.description} path={page.path} schema={schema}>
  {
    /*
      The shell (C-1): on a phone the lesson comes straight under the H1 and the
      intro under the lesson (DEC-044); the HTML keeps H1, intro, lesson.
    */
  }
  <PageShell
    width="tool"
    instrumentFirst
    instrumentClass="max-w-4xl"
    trail={trail}
    h1={page.h1}
    intro={page.intro}
  >
    <LessonIsland
      client:load
      nextSteps={nextSteps}
      dayTitles={t.curriculum.map((day) => day.title)}
      i18n={t.island('lesson')}
    />

    <section slot="more" aria-labelledby="how-heading" class="mf-prose">
      <h2 id="how-heading" class="font-display text-h2 font-bold text-ink">
        {t('learnPage.howHeading')}
      </h2>
      <p>
        <Rich
          nodes={t.rich('learnPage.seeIt')}
          tags={{ b: { el: 'strong' }, tree: { href: '/tree/' }, chart: { href: chartPost } }}
        />
      </p>
      <p><Rich nodes={t.rich('learnPage.hearIt')} tags={{ b: { el: 'strong' } }} /></p>
      <p><Rich nodes={t.rich('learnPage.sendIt')} tags={{ b: { el: 'strong' } }} /></p>
    </section>

    <section slot="more" aria-labelledby="covers-heading" class="mf-prose">
      <h2 id="covers-heading" class="font-display text-h2 font-bold text-ink">
        {t('learnPage.coversHeading')}
      </h2>
      <p>
        {
          t('learnPage.coversBody', {
            stages: stageCount,
            letters: FACTS.letterCount,
            digits: FACTS.digitCount,
            characters: LESSON_ORDER.length,
            first: t.list(first),
            codes: first
              .map((c) =>
                t('learnPage.firstCode', { character: c, code: prettify(MORSE_ALPHABET[c] ?? '') }),
              )
              .join(', '),
          })
        }
      </p>
      <ol>
        {stageLines.map((line) => <li>{line}</li>)}
      </ol>
      <p>{t('learnPage.drillBody', { minDrill, method: method.name })}</p>
    </section>

    <section slot="more" aria-labelledby="plan-heading" class="mf-prose">
      <h2 id="plan-heading" class="font-display text-h2 font-bold text-ink">
        {t('learnPage.planHeading')}
      </h2>
      <p>{t('learnPage.planBody', { planTime: FACTS.planTime })}</p>
      <p>
        <a href={plan.path}>{plan.h1}</a>{
          hasPage(howTo) && (
            <>
              {' '}
              · <a href={t.href(howTo)}>{t.page(howTo).h1}</a>
            </>
          )
        }
      </p>
    </section>
  </PageShell>
</BaseLayout>
