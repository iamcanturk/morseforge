---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SettingsScreen } from '../components/Settings/SettingsScreen'

const title = 'Settings | MorseForge'
const description =
  'Adjust the CW tone, speed, Farnsworth spacing and key bindings, and export or import your progress.'
---

<BaseLayout title={title} description={description} path="/settings/">
  <main class="mx-auto max-w-3xl px-6 py-14">
    <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Settings</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted">
      Everything applies immediately and is stored in this browser. There is no account and nothing
      is sent anywhere.
    </p>

    <div class="mt-10">
      <SettingsScreen client:load />
    </div>
  </main>
</BaseLayout>
