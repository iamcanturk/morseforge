---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageShell from '../components/PageShell.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import { SettingsScreen } from '../components/Settings/SettingsScreen'
import { breadcrumbTrail, getPage } from '../config/pages'
import '../styles/pkg-j.css'

/**
 * Settings: the station's control panel.
 *
 * Title, description, H1 and intro come from the page registry. BaseLayout
 * reads `indexable: false` from the same entry, so the page is noindex.
 * The theme switch is the header's own component, handed to the island as a
 * slot, so there is one implementation of theme switching, not two.
 */
const page = getPage('/settings/')
---

<BaseLayout title={page.title} description={page.description} path={page.path}>
  <PageShell
    width="tool"
    trail={breadcrumbTrail(page.path)}
    eyebrow="Applies instantly · Stored in this browser only"
    h1={page.h1}
    intro={page.intro}
  >
    <SettingsScreen client:load>
      <ThemeToggle slot="theme" />
    </SettingsScreen>
  </PageShell>
</BaseLayout>
