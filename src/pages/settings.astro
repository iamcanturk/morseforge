---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageShell from '../components/PageShell.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import { SettingsIsland } from '../components/Settings/SettingsScreen'
import { useTranslations } from '../i18n/server'
import '../styles/pkg-j.css'

/**
 * Settings: the station's control panel.
 *
 * Title, description, H1 and intro come from the page registry. BaseLayout
 * reads `indexable: false` from the same entry, so the page is noindex.
 * The theme switch is the header's own component, handed to the island as a
 * slot, so there is one implementation of theme switching, not two.
 */
const t = useTranslations(Astro)
const page = t.page('/settings/')
---

<BaseLayout title={page.title} description={page.description} path={page.path}>
  <PageShell
    width="tool"
    trail={t.trail(page.key)}
    eyebrow={t('settings.eyebrow')}
    h1={page.h1}
    intro={page.intro}
  >
    <SettingsIsland client:load i18n={t.island('settings')}>
      <ThemeToggle slot="theme" />
    </SettingsIsland>
  </PageShell>
</BaseLayout>
