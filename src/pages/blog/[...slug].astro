---
import '../../styles/pkg-i.css'
import type { GetStaticPaths } from 'astro'
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageShell from '../../components/PageShell.astro'
import { blogPage, breadcrumbTrail } from '../../config/pages'
import { FACTS } from '../../config/facts'
import { AUTHOR, CITATIONS } from '../../config/site'
import { numberWord } from '../../data/format'
import { article, breadcrumbs } from '../../seo/schema'

/**
 * A note, laid out as a page of the operator's manual: a numbered clause
 * heading each section, the answer in a boxed summary up front, and the body
 * set to a reading measure.
 */
export const getStaticPaths = (async () => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.published.getTime() - b.data.published.getTime(),
  )
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, number: index + 1, total: posts.length },
  }))
}) satisfies GetStaticPaths

const { post, number } = Astro.props
const { Content } = await render(post)

const meta = blogPage({ slug: post.id, ...post.data })
const markdown = `/blog/${post.id}.md`
const trail = breadcrumbTrail(meta.path, { name: post.data.title, parent: meta.parent })
const body = post.body ?? ''
const wordCount = body.split(/\s+/).filter(Boolean).length
// Cite a source only when the post actually links to it.
const cites = (['itu', 'arrl'] as const).filter((key) => body.includes(CITATIONS[key].url))
const updated =
  post.data.updated && post.data.updated.getTime() !== post.data.published.getTime()
    ? post.data.updated
    : undefined

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })

const schema = [
  article({
    type: 'BlogPosting',
    path: meta.path,
    headline: post.data.title,
    description: meta.description,
    datePublished: post.data.published,
    ...(updated ? { dateModified: updated } : {}),
    wordCount,
    cites,
    markdownPath: markdown,
  }),
  breadcrumbs(trail),
]
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  path={meta.path}
  schema={schema}
  markdown={markdown}
  article={{ published: post.data.published, modified: updated }}
  ogType="article"
>
  {
    /* Answer first: the post's whole answer is the paragraph under the H1,
      because it is the one a search snippet lifts and an assistant quotes. */
  }
  <PageShell
    width="prose"
    trail={trail}
    eyebrow={`Manual · Note ${String(number).padStart(2, '0')}`}
    h1={meta.h1}
    intro={post.data.answer}
  >
    <article>
      <p class="mf-engraved flex flex-wrap items-center gap-x-3 gap-y-1">
        <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
        {
          updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
              </span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <a href={AUTHOR.url} rel="author" class="hover:text-signal">{AUTHOR.name}</a>
      </p>

      <div class="mf-prose pi-manual mt-10">
        <Content />
      </div>

      <footer class="mt-16 border-t border-line pt-8">
        <ul class="flex flex-wrap gap-2" aria-label="Topics">
          {post.data.tags.map((tag) => <li class="mf-kbd px-2.5 py-1">{tag}</li>)}
        </ul>
        <p class="mt-6 text-sm text-muted">
          Also available as <a href={markdown} class="pi-link">plain Markdown</a>.
        </p>

        <div class="mf-instrument mt-10 p-6 sm:p-8">
          <p class="mf-engraved text-brass">Try it rather than read about it</p>
          <h2 class="pi-balance mt-3 font-display text-h2 font-bold text-ink">
            Learn Morse code in {FACTS.planDays} days
          </h2>
          <p class="pi-pretty mt-4 leading-relaxed text-muted">
            The plan teaches the alphabet in the order the code is built, with audio from the first
            character. About {FACTS.planTime} in total over {numberWord(FACTS.planDays)} days, free, no
            account.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/learn-morse-code-in-7-days/" class="mf-btn mf-btn-primary">Start the plan</a>
            <a href="/blog/" class="mf-btn mf-btn-ghost">All notes</a>
          </div>
        </div>
      </footer>
    </article>
  </PageShell>
</BaseLayout>
