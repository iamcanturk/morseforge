---
import type { GetStaticPaths } from 'astro'
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { AUTHOR, SITE } from '../../config/site'

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}) satisfies GetStaticPaths

const { post } = Astro.props
const { Content } = await render(post)

const path = `/blog/${post.id}/`
const markdown = `/blog/${post.id}.md`
const title = `${post.data.title} | MorseForge`

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.published.toISOString(),
    dateModified: (post.data.updated ?? post.data.published).toISOString(),
    url: new URL(path, SITE.url).href,
    mainEntityOfPage: new URL(path, SITE.url).href,
    author: { '@id': `${SITE.url}/#author` },
    publisher: { '@id': `${SITE.url}/#author` },
    isPartOf: { '@id': `${SITE.url}/#website` },
    inLanguage: 'en',
    keywords: post.data.tags.join(', '),
    // The answer, restated where a machine can find it without parsing prose.
    abstract: post.data.answer,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Notes', item: `${SITE.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: post.data.title },
    ],
  },
]
---

<BaseLayout
  title={title}
  description={post.data.description}
  path={path}
  schema={schema}
  markdown={markdown}
>
  <main class="mx-auto max-w-2xl px-6 py-14">
    <nav aria-label="Breadcrumb" class="font-mono text-[10px] tracking-[0.16em] text-muted">
      <a href="/blog/" class="hover:text-signal">NOTES</a>
    </nav>

    <article class="mt-5">
      <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
        {post.data.title}
      </h1>

      <div
        class="mt-4 flex flex-wrap items-center gap-3 font-mono text-[10px] tracking-[0.16em] text-muted"
      >
        <time datetime={post.data.published.toISOString()}>
          {formatDate(post.data.published).toUpperCase()}
        </time>
        <span aria-hidden="true">·</span>
        <a href={AUTHOR.url} rel="me author" class="hover:text-signal">
          {AUTHOR.name.toUpperCase()}
        </a>
      </div>

      {
        /* Answer-first: the whole answer before the argument for it, because
          this is the paragraph a search snippet lifts and an assistant quotes. */
      }
      <p
        class="mt-8 rounded-xl border-l-2 bg-panel py-4 pr-5 pl-5 text-lg leading-relaxed"
        style="border-color: var(--color-signal)"
      >
        {post.data.answer}
      </p>

      <div class="mf-prose mt-10">
        <Content />
      </div>

      <footer class="mt-14 border-t border-line pt-8">
        <ul class="flex flex-wrap gap-2">
          {
            post.data.tags.map((tag) => (
              <li class="rounded-lg border border-line px-3 py-1 font-mono text-[10px] tracking-[0.14em] text-muted">
                {tag.toUpperCase()}
              </li>
            ))
          }
        </ul>

        <div class="mt-8 rounded-xl border border-line bg-panel p-6">
          <h2 class="font-display text-lg font-semibold">Try it rather than read about it</h2>
          <p class="mt-2 leading-relaxed text-muted">
            The seven-day plan teaches the alphabet in the order the code is built, with audio from
            the first character. About two hours in total, free, no account.
          </p>
          <a
            href="/learn-morse-code-in-7-days/"
            class="mt-5 inline-block rounded-lg px-5 py-2.5 font-mono text-xs tracking-[0.14em] text-void"
            style="background: var(--color-signal)">START THE PLAN</a
          >
        </div>
      </footer>
    </article>
  </main>
</BaseLayout>
