---
import BaseLayout from '../layouts/BaseLayout.astro'
import { StatsScreen } from '../components/Stats/StatsScreen'

const title = 'Your Progress | MorseForge'
const description =
  'Your Morse code progress: level, streak, characters mastered, accuracy, best speed and achievements. Stored in your own browser.'
---

<BaseLayout title={title} description={description} path="/stats/">
  <main class="mx-auto max-w-3xl px-6 py-14">
    <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Your progress</h1>
    <p class="mt-3 leading-relaxed text-muted">
      Everything you have done, kept on this device. No account, no sync, nothing sent anywhere.
    </p>

    <div class="mt-10">
      <StatsScreen client:load />
    </div>
  </main>
</BaseLayout>
