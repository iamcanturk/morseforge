---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageShell from '../components/PageShell.astro'
import { StatsIsland, type StatsGame } from '../components/Stats/StatsScreen'
import { hasPage } from '../components/ui/siteNav'
import { useTranslations } from '../i18n/server'

const t = useTranslations(Astro)
const page = t.page('/stats/')
const trail = t.trail(page.key)

/** The games that keep a best, labelled from the registry, only if their page exists. */
const games: StatsGame[] = (
  [
    { id: 'defender', path: '/games/signal-defender/' },
    { id: 'runner', path: '/games/morse-runner/' },
  ] as const
)
  .filter((game) => hasPage(game.path))
  .map((game) => {
    const entry = t.page(game.path)
    return { id: game.id, label: entry.navLabel, href: entry.path }
  })
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.path}
  noindex={!page.indexable}
>
  <PageShell width="tool" trail={trail} h1={page.h1} intro={page.intro}>
    <StatsIsland client:load games={games} i18n={t.island('stats')} />
  </PageShell>
</BaseLayout>
