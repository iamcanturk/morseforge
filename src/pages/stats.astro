---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageShell from '../components/PageShell.astro'
import { StatsScreen, type StatsGame } from '../components/Stats/StatsScreen'
import { hasPage } from '../components/ui/siteNav'
import { breadcrumbTrail, getPage } from '../config/pages'

const page = getPage('/stats/')
const trail = breadcrumbTrail(page.path)

/** The games that keep a best, labelled from the registry, only if their page exists. */
const games: StatsGame[] = (
  [
    { id: 'defender', path: '/games/signal-defender/' },
    { id: 'runner', path: '/games/morse-runner/' },
  ] as const
)
  .filter((game) => hasPage(game.path))
  .map((game) => ({ id: game.id, label: getPage(game.path).navLabel, href: game.path }))
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.path}
  noindex={!page.indexable}
>
  <PageShell width="tool" trail={trail} h1={page.h1} intro={page.intro}>
    <StatsScreen client:load games={games} />
  </PageShell>
</BaseLayout>
