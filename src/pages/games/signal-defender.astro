---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Faq from '../../components/Faq.astro'
import PageShell from '../../components/PageShell.astro'
import Rich from '../../components/I18n/Rich.astro'
import { SignalDefenderGame } from '../../components/Games/games'
import { breadcrumbs, webPage } from '../../seo/schema'
import { useTranslations } from '../../i18n/server'

// Title, description, H1 and intro all come from the registry (SEO-B); the
// island gets the registry's name and URL for its share text.
const t = useTranslations(Astro)
const page = t.page('/games/signal-defender/')
const trail = t.trail(page.key)
const faq = t.faq(page.key)
const schema = [
  webPage({ path: page.path, name: page.h1, description: page.description }),
  breadcrumbs(trail),
]
const link = 'text-signal underline underline-offset-4'
const other = t.page('/games/morse-runner/')
---

<BaseLayout title={page.title} description={page.description} path={page.path} schema={schema}>
  <PageShell width="tool" trail={trail} h1={page.h1} intro={page.intro} instrumentFirst>
    <SignalDefenderGame
      client:idle
      name={page.navLabel}
      url={t.url(page.key)}
      i18n={t.island('defender')}
    />

    <section slot="more" class="max-w-3xl">
      <h2 class="font-display text-h2 font-bold">{t('gamesPage.defenderHeading')}</h2>
      <p class="mt-4 leading-relaxed text-muted">
        <Rich nodes={t.rich('gamesPage.defenderWhy')} />
      </p>
      <p class="mt-4 leading-relaxed text-muted">{t('gamesPage.defenderGap')}</p>

      <p class="mt-8 text-sm leading-relaxed text-muted">
        <Rich
          nodes={t.rich('gamesPage.defenderOther', { name: other.navLabel })}
          tags={{ other: { href: other.key, class: link } }}
        />
      </p>
    </section>

    <Faq slot="more" items={faq} />
  </PageShell>
</BaseLayout>
