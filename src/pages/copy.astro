---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageShell from '../components/PageShell.astro'
import Faq from '../components/Faq.astro'
import { CopyScreen } from '../components/Copy/CopyScreen'
import { breadcrumbTrail, getPage } from '../config/pages'
import { faqFor } from '../data/faq'
import { breadcrumbs, webPage } from '../seo/schema'
import '../styles/pkg-f.css'

const page = getPage('/copy/')
const trail = breadcrumbTrail(page.path)
const faq = faqFor(page.path)
const practice = getPage('/practice/')
const challenge = getPage('/challenge/')
const daily = getPage('/daily/')

const schema = [
  webPage({ path: page.path, name: page.h1, description: page.description }),
  breadcrumbs(trail),
]
---

<BaseLayout title={page.title} description={page.description} path={page.path} schema={schema}>
  <PageShell
    width="tool"
    trail={trail}
    h1={page.h1}
    intro={page.intro}
    instrumentFirst
    instrumentClass="max-w-4xl"
  >
    <CopyScreen client:load />

    <div slot="more" class="mf-prose max-w-[68ch]">
      <p>
        Working on single characters instead? Try <a href={practice.path}>{practice.navLabel}</a>{
          ' '
        }
        or the <a href={challenge.path}>{challenge.navLabel}</a>. Want the same lines as everyone
        else today? That is the <a href={daily.path}>{daily.navLabel.toLowerCase()}</a>.
      </p>
    </div>

    {faq.length > 0 && <Faq slot="more" items={faq} />}
  </PageShell>
</BaseLayout>
