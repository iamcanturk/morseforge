---
import '../styles/pkg-i.css'
import BaseLayout from '../layouts/BaseLayout.astro'
import Pips from '../components/Alphabet/Pips.astro'
import { getPage } from '../config/pages'
import { MORSE_ALPHABET, PUNCTUATION_NAMES } from '../data/morseAlphabet'
import { prettify } from '../engine/morseEncoder'

const page = getPage('/404/')

/** "?" in Morse. A 404 is the one place a puzzle is welcome. */
const question = MORSE_ALPHABET['?'] ?? ''

/** A handful of real destinations beats a bare "go home" link. Labels from the registry. */
const routes = [
  '/learn-morse-code-in-7-days/',
  '/morse-code-translator/',
  '/morse-code-alphabet/',
  '/words/',
  '/telegraph/',
  '/tree/',
].map((path) => getPage(path))
---

<BaseLayout title={page.title} description={page.description} path={page.path} noindex={true}>
  <main class="mx-auto max-w-4xl px-5 py-14 sm:px-6 sm:py-20">
    <div class="mf-instrument p-3 sm:p-4">
      <div
        class="mf-screen mf-grid mf-power-on grid place-items-center px-6 py-14 text-center sm:py-20"
      >
        <p
          class="relative font-display text-glyph font-bold text-signal mf-phosphor"
          aria-hidden="true"
        >
          ?
        </p>
        <Pips code={question} size="lg" class="relative mt-4 justify-center text-signal" />
        <p class="relative mt-5 font-mono text-control tracking-code text-muted">
          <span class="sr-only">A {PUNCTUATION_NAMES['?']} in Morse code: </span>{
            prettify(question)
          }
        </p>
      </div>
    </div>

    <div class="mx-auto mt-12 max-w-2xl text-center">
      <p class="mf-engraved text-brass">Error 404 · No carrier</p>
      <h1 class="pi-balance mt-3 font-display text-h1 font-bold text-ink">{page.h1}</h1>
      <p class="pi-pretty mt-4 text-lead text-muted">
        {page.intro} The signal above is a {PUNCTUATION_NAMES['?']}, which is roughly what the
        server said too.
      </p>
    </div>

    <nav aria-label="Where to go instead" class="mt-12">
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          routes.map((route) => (
            <li>
              <a href={route.path} class="mf-card h-full">
                <span class="font-display text-h3 font-bold">{route.navLabel}</span>
                <span class="text-sm text-muted">{route.hint}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-center">
        <a href="/" class="mf-btn mf-btn-secondary">Back to the start</a>
      </p>
    </nav>
  </main>
</BaseLayout>
