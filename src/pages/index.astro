---
/**
 * The landing page (TASK-001 §5; DEC-012).
 *
 * PROJECT.md §57: do not open with four paragraphs explaining what Morse is.
 * Open with a key the visitor can press. The hero is a working instrument and
 * the first interactive element on the page; everything below it is for the
 * people who sent a letter and want more, and for the search engines and
 * answer engines that read the page without pressing anything.
 *
 * Every word comes from the registry (`getPage('/')`, `LANDING`, `faqFor`);
 * every number from the data it describes. JavaScript above the fold is the
 * hero's vanilla script only; the decode puzzle is the one React island, and
 * it hydrates when scrolled to.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Faq from '../components/Faq.astro'
import FactsPanel from '../components/Landing/FactsPanel.astro'
import HowItWorks from '../components/Landing/HowItWorks.astro'
import Linked from '../components/Landing/Linked.astro'
import NetworkTree from '../components/Landing/NetworkTree.astro'
import SignalHero from '../components/Landing/SignalHero.astro'
import ToolGrid from '../components/Landing/ToolGrid.astro'
import { DecodeChallenge } from '../components/Decode/DecodeChallenge'
import { LANDING } from '../config/landing'
import { getPage } from '../config/pages'
import { faqFor } from '../data/faq'
import { encode, prettify } from '../engine/morseEncoder'
import { spokenCode } from '../engine/spokenCode'
import { HERO_TARGETS, codeOf, describeCode } from '../components/Landing/hero'
import { IDS, webPage } from '../seo/schema'
import '../styles/pkg-b.css'

const page = getPage('/')
const faq = faqFor(page.path)
const schema = [
  webPage({
    path: page.path,
    name: page.h1,
    description: page.description,
    mainEntityId: IDS.app,
  }),
]

const first = HERO_TARGETS[0] ?? ''
const sos = encode('SOS')
/** What the band shows, read out: "dot dot dot, dash dash dash, dot dot dot". */
const sosSpoken = sos.split(' ').map(spokenCode).join(', ')
---

<BaseLayout title={page.title} description={page.description} path={page.path} schema={schema}>
  <main>
    <SignalHero />

    <FactsPanel />

    {/* Section 3: the decode puzzle, as a telegram form. */}
    <section id="decode" class="py-16 md:py-24" aria-labelledby="decode-heading">
      <div
        class="mx-auto grid max-w-7xl gap-8 px-5 sm:px-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14"
      >
        <div class="lg:pt-8">
          <p class="mf-engraved text-brass">Incoming</p>
          <h2 id="decode-heading" class="mt-3 font-display text-h2 font-bold text-ink">
            {LANDING.decode.heading}
          </h2>
          <p class="mt-4 max-w-[40ch] text-lead text-muted">{LANDING.decode.lead}</p>
        </div>
        <DecodeChallenge client:visible />
      </div>
    </section>

    <NetworkTree />

    <HowItWorks />

    <ToolGrid />

    {/* Section 7: the operator's manual. */}
    <section class="py-16 md:py-24" aria-labelledby="why-heading">
      <div
        class="mx-auto grid max-w-7xl gap-12 px-5 sm:px-6 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16"
      >
        <article>
          <p class="mf-engraved text-brass">Operator's manual</p>
          <h2 id="why-heading" class="mt-3 font-display text-h2 font-bold text-ink">
            {LANDING.why.heading}
          </h2>
          <div class="mt-6 max-w-[68ch] space-y-5 leading-relaxed text-muted">
            {LANDING.why.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <a
            href={LANDING.why.link.href}
            class="mt-6 inline-block text-signal underline decoration-signal/40 underline-offset-4 hover:decoration-signal"
          >
            {LANDING.why.link.text} →
          </a>
        </article>

        <aside class="mf-panel self-start p-6 sm:p-8" aria-labelledby="what-mf-heading">
          <p class="flex items-center gap-2 mf-engraved">
            <span class="mf-lamp" aria-hidden="true"></span>
            The station
          </p>
          <h2 id="what-mf-heading" class="mt-3 font-display text-h3 font-bold text-ink">
            {LANDING.whatMorseForgeIs.heading}
          </h2>
          <Linked
            paragraph={LANDING.whatMorseForgeIs.paragraph}
            class="mt-3 leading-relaxed text-muted"
          />
        </aside>
      </div>
    </section>

    {
      /* The same column as every other landing section (V-06): the FAQ starts at their left edge. */
    }
    <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 md:py-24">
      <Faq items={faq} heading={LANDING.faq.heading} />
    </div>

    {/* Section 8: the closing band. Native anchor; the hero script hands over the key. */}
    <section class="px-5 pt-8 pb-20 sm:px-6 md:pb-28" aria-labelledby="closing-heading">
      <div
        class="mf-screen mf-grid mx-auto flex max-w-7xl flex-col items-start gap-6 px-6 py-10 sm:px-10 md:flex-row md:items-center md:justify-between"
      >
        <div class="relative z-[3]">
          <p class="closing-code font-mono mf-phosphor text-signal" aria-hidden="true">
            {prettify(sos)}
          </p>
          <h2 id="closing-heading" class="mt-3 font-display text-h3 font-bold text-ink">
            <span class="sr-only">{sosSpoken} </span>is SOS. Your first letter is {first} — {
              describeCode(codeOf(first))
            }.
          </h2>
        </div>
        <a href="#station" class="relative z-[3] mf-btn mf-btn-primary mf-btn-lg" data-focus-key
          >Send it</a
        >
      </div>
    </section>
  </main>
</BaseLayout>
