---
import BaseLayout from '../layouts/BaseLayout.astro'
import { Logo } from '../components/brand/Logo'
import { SITE } from '../config/site'

const title = 'MorseForge — Learn Morse Code as a Game'
const description = SITE.description

const routes = [
  {
    href: '/telegraph/',
    label: 'Telegraph',
    blurb: 'Use your keyboard as a straight key. Tap for a dot, hold for a dash, decode live.',
  },
  {
    href: '/tree/',
    label: 'Signal Tree',
    blurb: 'See why every letter has the code it has — a dot branches left, a dash branches right.',
  },
]
---

<BaseLayout title={title} description={description} path="/">
  <main class="mx-auto max-w-4xl px-6 py-20">
    <div class="flex flex-col items-center text-center">
      <Logo size={56} tagline glow />

      <p class="mt-10 max-w-xl text-lg leading-relaxed text-muted">
        Turn Morse code into a game. Learn it, send it, hear it, decode it — and watch the signal
        network come online one character at a time.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/telegraph/"
          class="rounded-lg px-6 py-3 font-mono text-xs tracking-[0.16em] text-void"
          style="background: var(--color-signal)">SEND YOUR FIRST SIGNAL</a
        >
        <a
          href="/tree/"
          class="rounded-lg border border-line px-6 py-3 font-mono text-xs tracking-[0.16em] text-muted transition-colors hover:border-signal hover:text-signal"
          >EXPLORE THE TREE</a
        >
      </div>

      <p class="mt-8 font-mono text-[10px] tracking-[0.18em] text-signal-dim">
        NO ACCOUNT · NO ADS · PROGRESS STAYS ON YOUR DEVICE
      </p>
    </div>

    <div class="mt-20 grid gap-5 sm:grid-cols-2">
      {
        routes.map(({ href, label, blurb }) => (
          <a
            href={href}
            class="rounded-xl border border-line bg-panel p-6 transition-colors hover:border-signal-dim"
          >
            <h2 class="font-display text-lg font-semibold">{label}</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">{blurb}</p>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>
