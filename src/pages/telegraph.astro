---
import BaseLayout from '../layouts/BaseLayout.astro'
import Faq from '../components/Faq.astro'
import PageShell from '../components/PageShell.astro'
import Rich from '../components/I18n/Rich.astro'
import { TelegraphIsland } from '../components/MorseKey/TelegraphScreen'
import { presetLabel } from '../components/MorseKey/keyCopy'
import { formatSeconds } from '../data/format'
import { findWord, wordLabel } from '../data/words'
import { dotDuration } from '../engine/timingEngine'
import { encode, prettify } from '../engine/morseEncoder'
import { breadcrumbs, webPage } from '../seo/schema'
import { KEYER_PRESETS, WPM_PRESETS, defaultSettings } from '../storage/settings'
import { useTranslations } from '../i18n/server'
import type { RichTags } from '../i18n/richTags'

const t = useTranslations(Astro)
const page = t.page('/telegraph/')
const faq = t.faq(page.key)
const trail = t.trail(page.key)
const schema = [
  webPage({ path: page.path, name: page.h1, description: page.description }),
  breadcrumbs(trail),
]

// Every number below is read from the settings the key actually runs on.
const defaults = defaultSettings()
const dashAfter = defaults.timing.dotDashThresholdMs
const learningGap = formatSeconds(KEYER_PRESETS.learning.characterGapMs)
const learningWordGap = formatSeconds(KEYER_PRESETS.learning.wordGapMs)
const operatorWpm = WPM_PRESETS.normal
// A character ends after three units of silence (the inter-character gap).
const operatorGapMs = Math.round(3 * dotDuration(operatorWpm))
const manual = presetLabel(t, 'manual')
const learning = presetLabel(t, 'learning')

const word = (slug: string) => {
  const entry = findWord(slug)
  if (!entry) throw new Error(`telegraph.astro: no "${slug}" in WORDS`)
  return {
    href: `/words/${entry.slug}/`,
    label: wordLabel(entry),
    code: prettify(encode(entry.text)),
  }
}
const sos = word('sos')
const cq = word('cq')
const regards = word('73')
const love = word('88')
const s = prettify(encode('S'))
/** The word links to its page; its code is set in the mono face. */
function wordTags(href: string): RichTags {
  return { word: { href }, code: { el: 'span', class: 'font-mono tracking-code' } }
}
---

<BaseLayout title={page.title} description={page.description} path={page.path} schema={schema}>
  <PageShell width="tool" trail={trail} h1={page.h1} intro={page.intro} instrumentFirst>
    {
      /* client:load, not visible/idle: the key is this page's first interactive
         element and sits in the first screenful, and someone who lands here
         presses Space straight away. */
    }
    <TelegraphIsland client:load i18n={t.island('telegraph')} />

    <div slot="more" class="mf-prose">
      <h2>{t('telegraphPage.howHeading')}</h2>
      <p>{t('telegraphPage.howBody', { dashAfter })}</p>
      <p>
        <Rich
          nodes={t.rich('telegraphPage.letterBody', { code: s })}
          tags={{ b: { el: 'strong' } }}
        />
      </p>

      <h2>{t('telegraphPage.waitHeading')}</h2>
      <p>
        {
          t('telegraphPage.waitBody', {
            wpm: operatorWpm,
            gap: operatorGapMs,
            learning,
            characterGap: learningGap,
            wordGap: learningWordGap,
            manual,
          })
        }
      </p>

      <h2>{t('telegraphPage.firstHeading')}</h2>
      <p>{t('telegraphPage.firstBody')}</p>
      <ul>
        <li>
          <Rich nodes={t.rich('telegraphPage.sos', sos)} tags={wordTags(sos.href)} />
        </li>
        <li>
          <Rich nodes={t.rich('telegraphPage.cq', cq)} tags={wordTags(cq.href)} />
        </li>
        <li>
          <Rich nodes={t.rich('telegraphPage.regards', regards)} tags={wordTags(regards.href)} />
        </li>
        <li>
          <Rich nodes={t.rich('telegraphPage.love', love)} tags={wordTags(love.href)} />
        </li>
      </ul>
      <p>{t('telegraphPage.privacyBody')}</p>
    </div>

    <Faq slot="more" items={faq} />
  </PageShell>
</BaseLayout>
