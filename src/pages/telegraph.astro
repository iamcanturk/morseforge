---
import BaseLayout from '../layouts/BaseLayout.astro'
import Faq from '../components/Faq.astro'
import PageShell from '../components/PageShell.astro'
import { TelegraphScreen } from '../components/MorseKey/TelegraphScreen'
import { breadcrumbTrail, getPage } from '../config/pages'
import { faqFor } from '../data/faq'
import { formatSeconds } from '../data/format'
import { findWord, wordLabel } from '../data/words'
import { dotDuration } from '../engine/timingEngine'
import { encode, prettify } from '../engine/morseEncoder'
import { breadcrumbs, webPage } from '../seo/schema'
import { KEYER_PRESETS, WPM_PRESETS, defaultSettings } from '../storage/settings'

const page = getPage('/telegraph/')
const faq = faqFor(page.path)
const trail = breadcrumbTrail(page.path)
const schema = [
  webPage({ path: page.path, name: page.h1, description: page.description }),
  breadcrumbs(trail),
]

// Every number below is read from the settings the key actually runs on.
const defaults = defaultSettings()
const dashAfter = defaults.timing.dotDashThresholdMs
const learningGap = formatSeconds(KEYER_PRESETS.learning.characterGapMs)
const learningWordGap = formatSeconds(KEYER_PRESETS.learning.wordGapMs)
const operatorWpm = WPM_PRESETS.normal
// A character ends after three units of silence (the inter-character gap).
const operatorGapMs = Math.round(3 * dotDuration(operatorWpm))
const manual = KEYER_PRESETS.manual.label
const learning = KEYER_PRESETS.learning.label

const word = (slug: string) => {
  const entry = findWord(slug)
  if (!entry) throw new Error(`telegraph.astro: no "${slug}" in WORDS`)
  return {
    href: `/words/${entry.slug}/`,
    label: wordLabel(entry),
    code: prettify(encode(entry.text)),
  }
}
const sos = word('sos')
const cq = word('cq')
const regards = word('73')
const love = word('88')
const s = prettify(encode('S'))
---

<BaseLayout title={page.title} description={page.description} path={page.path} schema={schema}>
  <PageShell width="tool" trail={trail} h1={page.h1} intro={page.intro} instrumentFirst>
    {
      /* client:load, not visible/idle: the key is this page's first interactive
         element and sits in the first screenful, and someone who lands here
         presses Space straight away. */
    }
    <TelegraphScreen client:load />

    <div slot="more" class="mf-prose">
      <h2>How to send Morse code with a keyboard</h2>
      <p>
        The Space bar is the key. Press it and the sidetone sounds for as long as you hold it: let
        go quickly for a dot, hold it past {dashAfter} ms for a dash. Then stop. When the key has been
        quiet long enough, the elements you sent are read as one character and printed on the tape. Stay
        quiet a little longer and the word ends too. On a phone or tablet, press and hold the brass key
        on the screen instead; it behaves exactly the same.
      </p>
      <p>
        To send the letter S, tap three times ({s}) and wait. To send the word, send each letter the
        same way, with a pause between them. If a character finishes before you meant it to, press{
          ' '
        }
        <strong>Finish</strong> yourself next time, or give the key more time below it.
      </p>

      <h2>Why the key waits for you</h2>
      <p>
        How patient the key is has nothing to do with speed. At {operatorWpm} WPM a character ends after
        {operatorGapMs} ms of silence, which is right for a practised operator and hopeless for a beginner
        who means to send S and, after a moment of doubt, has sent E three times. So the telegraph starts
        on {learning}: a character ends after {learningGap} seconds of quiet and a word after {
          learningWordGap
        }. Switch to {manual} and nothing finishes until you say so. The fuse between the tape and the
        key shows how long you have left.
      </p>

      <h2>What to send first</h2>
      <p>
        Pick a target above the key and the tape checks it letter by letter as you send. A few words
        every operator knows are worth trying:
      </p>
      <ul>
        <li>
          <a href={sos.href}>{sos.label}</a> (<span class="font-mono tracking-code">{sos.code}</span
          >), the distress signal, which also works sent as one unbroken character.
        </li>
        <li>
          <a href={cq.href}>{cq.label}</a> (<span class="font-mono tracking-code">{cq.code}</span>),
          a call to any station listening.
        </li>
        <li>
          <a href={regards.href}>{regards.label}</a> (<span class="font-mono tracking-code"
            >{regards.code}</span
          >), best regards, the usual sign-off.
        </li>
        <li>
          <a href={love.href}>{love.label}</a> (<span class="font-mono tracking-code"
            >{love.code}</span
          >), love and kisses.
        </li>
      </ul>
      <p>
        The text you key is never uploaded, and the telegram you can share at the end is drawn on
        your own screen. If anonymous counters are on in Settings, the site counts that a word was
        sent, and which of the four words above turned up; nothing more.
      </p>
    </div>

    <Faq slot="more" items={faq} />
  </PageShell>
</BaseLayout>
