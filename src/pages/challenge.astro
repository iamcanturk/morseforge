---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageShell from '../components/PageShell.astro'
import Faq from '../components/Faq.astro'
import Rich from '../components/I18n/Rich.astro'
import { PracticeIsland } from '../components/Practice/PracticeScreen'
import { FACTS } from '../config/facts'
import { SITE } from '../config/site'
import { absoluteUrl, breadcrumbs, webPage } from '../seo/schema'
import { BOUNDS, DEFAULT_CHALLENGE, challengePool, challengeQuery } from '../game/challengeLink'
import { LEARNING_STAGES } from '../data/morseAlphabet'
import { encode, prettify } from '../engine/morseEncoder'
import { useTranslations } from '../i18n/server'

const t = useTranslations(Astro)
const page = t.page('/challenge/')
const daily = t.page('/daily/')
const learn = t.page('/learn/')
const faq = t.faq(page.key)
const trail = t.trail(page.key)

const pool = challengePool(DEFAULT_CHALLENGE)
const first = LEARNING_STAGES[0] ?? []
// An example of the link a finished run produces, built by the same code that
// builds the real ones, so the page can never show a format the app rejects.
const example = `${t.href('/challenge/')}${challengeQuery({ ...DEFAULT_CHALLENGE, seed: 'k7f3', beat: 340 })}`

const schema = [
  webPage({ path: page.path, name: page.h1, description: page.description }),
  breadcrumbs(trail),
  {
    '@context': 'https://schema.org',
    '@type': ['Game', 'Quiz'],
    name: page.h1,
    description: page.description,
    url: absoluteUrl(page.path),
    author: { '@id': `${SITE.url}/#author` },
    gamePlatform: t('challengePage.platform'),
    numberOfPlayers: { '@type': 'QuantitativeValue', value: 1 },
    educationalLevel: 'Beginner',
    teaches: t('challengePage.teaches'),
    isAccessibleForFree: true,
  },
]
const link = 'text-signal underline underline-offset-4'
---

<BaseLayout title={page.title} description={page.description} path={page.path} schema={schema}>
  <PageShell
    width="tool"
    trail={trail}
    h1={page.h1}
    intro={page.intro}
    instrumentFirst
    instrumentClass="max-w-4xl"
  >
    <PracticeIsland client:load challenge i18n={t.island('practice')} />

    <section slot="more" aria-labelledby="new-heading" class="max-w-[68ch]">
      <h2 id="new-heading" class="font-display text-h2 font-bold text-ink">
        {t('challengePage.newHeading')}
      </h2>
      <p class="mt-4 leading-relaxed text-muted">
        <Rich
          nodes={t.rich('challengePage.newBody', {
            pool: pool.length,
            seconds: FACTS.challengeSeconds,
            dot: first[0] ?? '',
            dotCode: prettify(encode(first[0] ?? '')),
            dash: first[1] ?? '',
            dashCode: prettify(encode(first[1] ?? '')),
            days: FACTS.planDays,
            letters: FACTS.letterCount,
            planTime: FACTS.planTime,
          })}
          tags={{ learn: { href: learn.key, class: link } }}
        />
      </p>
      <p class="mt-4 leading-relaxed text-muted">
        <Rich
          nodes={t.rich('challengePage.retakeBody', {
            daily: daily.navLabel.toLocaleLowerCase(t.locale.lang),
            lines: FACTS.dailyLines,
          })}
          tags={{ daily: { href: daily.key, class: link } }}
        />
      </p>
    </section>

    <section slot="more" aria-labelledby="send-heading" class="max-w-[68ch]">
      <h2 id="send-heading" class="font-display text-h2 font-bold text-ink">
        {t('challengePage.sendHeading')}
      </h2>
      <p class="mt-4 leading-relaxed text-muted">{t('challengePage.sendBody')}</p>
      <pre
        class="mf-screen mf-screen-flush mt-5 overflow-x-auto p-4 font-mono text-sm text-signal"><code class="relative z-[3]">{example}</code></pre>
      <p class="mt-5 leading-relaxed text-muted">
        {
          t('challengePage.serverBody', {
            timeMin: BOUNDS.time.min,
            timeMax: BOUNDS.time.max,
            wpmMin: BOUNDS.wpm.min,
            wpmMax: BOUNDS.wpm.max,
          })
        }
      </p>
      <p class="mt-4 leading-relaxed text-muted">{t('challengePage.leaderboardBody')}</p>
    </section>

    <Faq slot="more" items={faq} />
  </PageShell>
</BaseLayout>
