---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageShell from '../components/PageShell.astro'
import Faq from '../components/Faq.astro'
import { PracticeScreen } from '../components/Practice/PracticeScreen'
import { breadcrumbTrail, getPage } from '../config/pages'
import { faqFor } from '../data/faq'
import { FACTS } from '../config/facts'
import { SITE } from '../config/site'
import { absoluteUrl, breadcrumbs, webPage } from '../seo/schema'
import { BOUNDS, DEFAULT_CHALLENGE, challengePool, challengeQuery } from '../game/challengeLink'
import { LEARNING_STAGES } from '../data/morseAlphabet'
import { encode, prettify } from '../engine/morseEncoder'

const page = getPage('/challenge/')
const daily = getPage('/daily/')
const learn = getPage('/learn/')
const faq = faqFor(page.path)
const trail = breadcrumbTrail(page.path)

const pool = challengePool(DEFAULT_CHALLENGE)
const first = LEARNING_STAGES[0] ?? []
// An example of the link a finished run produces, built by the same code that
// builds the real ones, so the page can never show a format the app rejects.
const example = `/challenge/${challengeQuery({ ...DEFAULT_CHALLENGE, seed: 'k7f3', beat: 340 })}`

const schema = [
  webPage({ path: page.path, name: page.h1, description: page.description }),
  breadcrumbs(trail),
  {
    '@context': 'https://schema.org',
    '@type': ['Game', 'Quiz'],
    name: page.h1,
    description: page.description,
    url: absoluteUrl(page.path),
    author: { '@id': `${SITE.url}/#author` },
    gamePlatform: 'Web browser',
    numberOfPlayers: { '@type': 'QuantitativeValue', value: 1 },
    educationalLevel: 'Beginner',
    teaches: 'International Morse code',
    isAccessibleForFree: true,
  },
]
---

<BaseLayout title={page.title} description={page.description} path={page.path} schema={schema}>
  <PageShell
    width="tool"
    trail={trail}
    h1={page.h1}
    intro={page.intro}
    instrumentFirst
    instrumentClass="max-w-4xl"
  >
    <PracticeScreen client:load challenge />

    <section slot="more" aria-labelledby="new-heading" class="max-w-[68ch]">
      <h2 id="new-heading" class="font-display text-h2 font-bold text-ink">
        Never done this before?
      </h2>
      <p class="mt-4 leading-relaxed text-muted">
        The standard run draws from the first {pool.length} letters of the teaching order, so{' '}
        {FACTS.challengeSeconds} seconds is enough to score with only a few of them. {first[0]} is one
        dot ({prettify(encode(first[0] ?? ''))}) and {first[1]} is one dash ({
          prettify(encode(first[1] ?? ''))
        }). The <a href={learn.path} class="text-signal underline underline-offset-4"
          >guided lessons</a
        > follow the {FACTS.planDays}-day plan, which takes you from there to all {
          FACTS.letterCount
        } letters in about {FACTS.planTime} of practice.
      </p>
      <p class="mt-4 leading-relaxed text-muted">
        Retake it as often as you like; every run you start yourself gets a new sequence. If you
        want one fixed test a day instead, the <a
          href={daily.path}
          class="text-signal underline underline-offset-4">{daily.navLabel.toLowerCase()}</a
        > is the same {FACTS.dailyLines} lines for everyone.
      </p>
    </section>

    <section slot="more" aria-labelledby="send-heading" class="max-w-[68ch]">
      <h2 id="send-heading" class="font-display text-h2 font-bold text-ink">
        Challenging someone else
      </h2>
      <p class="mt-4 leading-relaxed text-muted">
        Finish a run and you get a link that carries the whole test: a seed that fixes which
        characters come up and in what order, how many letters it draws from, the length, the speed,
        and your score to beat.
      </p>
      <pre
        class="mf-screen mf-screen-flush mt-5 overflow-x-auto p-4 font-mono text-sm text-signal"><code class="relative z-[3]">{example}</code></pre>
      <p class="mt-5 leading-relaxed text-muted">
        Your friend hears exactly what you heard, so the two scores are comparable. There is no
        server behind it: everything is in the URL, so the link works offline and keeps working.
        That also means the score on a link is a claim, and the page shows it as one. Values outside
        a sensible range are clamped rather than trusted, from {BOUNDS.time.min} to {
          BOUNDS.time.max
        } seconds and {BOUNDS.wpm.min} to {BOUNDS.wpm.max} WPM, and a broken link falls back to the standard
        test instead of an error.
      </p>
      <p class="mt-4 leading-relaxed text-muted">
        There is no global leaderboard, because ranking strangers honestly needs a server that
        checks every score. Your own best and a friend's link are the comparisons this can make
        truthfully.
      </p>
    </section>

    <Faq slot="more" items={faq} />
  </PageShell>
</BaseLayout>
