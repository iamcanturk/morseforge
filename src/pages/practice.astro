---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageShell from '../components/PageShell.astro'
import Faq from '../components/Faq.astro'
import Rich from '../components/I18n/Rich.astro'
import { PracticeIsland } from '../components/Practice/PracticeScreen'
import { methodCopy, modeCopy } from '../components/Practice/copy'
import { METHOD_IDS, DEFAULT_METHOD } from '../data/methods'
import { SESSION_MODES, type SessionMode } from '../game/session'
import { absoluteUrl, breadcrumbs, webPage } from '../seo/schema'
import { FACTS, MASTERY_RULE } from '../config/facts'
import type { MessageKey } from '../i18n/keys'
import { useTranslations } from '../i18n/server'

const t = useTranslations(Astro)
const page = t.page('/practice/')
const copy = t.page('/copy/')
const challenge = t.page('/challenge/')
const faq = t.faq(page.key)
const trail = t.trail(page.key)

const schema = [
  webPage({ path: page.path, name: page.h1, description: page.description }),
  breadcrumbs(trail),
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: page.h1,
    description: page.description,
    url: absoluteUrl(page.path),
    learningResourceType: 'Practice',
    educationalLevel: 'Beginner',
    teaches: t('practicePage.teaches'),
    isAccessibleForFree: true,
  },
]

/** What each mode trains, in the words of the mode list itself. */
const MODE_NOTES: Record<SessionMode, MessageKey> = {
  listening: 'practicePage.noteListening',
  recognition: 'practicePage.noteRecognition',
  sending: 'practicePage.noteSending',
}
const modes = Object.keys(SESSION_MODES) as SessionMode[]
const link = 'text-signal underline underline-offset-4'
---

<BaseLayout title={page.title} description={page.description} path={page.path} schema={schema}>
  <PageShell
    width="tool"
    trail={trail}
    h1={page.h1}
    intro={page.intro}
    instrumentFirst
    instrumentClass="max-w-4xl"
  >
    <PracticeIsland client:load i18n={t.island('practice')} />

    <section slot="more" aria-labelledby="modes-heading" class="max-w-[68ch]">
      <h2 id="modes-heading" class="font-display text-h2 font-bold text-ink">
        {t('practicePage.modesHeading')}
      </h2>
      <p class="mt-4 leading-relaxed text-muted">
        {t('practicePage.modesBody', { rule: MASTERY_RULE })}
      </p>
      <ul class="mt-6 grid gap-4">
        {
          modes.map((id) => (
            <li class="mf-panel p-5">
              <p class="mf-engraved">{modeCopy(t, id).label}</p>
              <p class="mt-2 leading-relaxed text-ink">
                <Rich
                  nodes={t.rich('practicePage.modeLine', {
                    prompt: modeCopy(t, id).prompt,
                    note: t.raw(MODE_NOTES[id]),
                  })}
                  tags={{ note: { class: 'text-muted' } }}
                />
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section slot="more" aria-labelledby="order-heading" class="max-w-[68ch]">
      <h2 id="order-heading" class="font-display text-h2 font-bold text-ink">
        {t('practicePage.orderHeading')}
      </h2>
      <p class="mt-4 leading-relaxed text-muted">
        <Rich
          nodes={t.rich('practicePage.orderBody', { method: methodCopy(t, DEFAULT_METHOD).name })}
          tags={{ post: { href: '/blog/which-order-should-you-learn-morse-in/', class: link } }}
        />
      </p>
      <dl class="mt-6 grid gap-6">
        {
          METHOD_IDS.map((id) => {
            const method = methodCopy(t, id)
            return (
              <div>
                <dt class="font-display text-h3 font-bold text-ink">
                  {method.name}
                  <span class="mt-1 block font-body text-sm font-normal text-muted">
                    {method.summary}
                  </span>
                </dt>
                <dd class="mt-2 leading-relaxed text-muted">{method.rationale}</dd>
              </div>
            )
          })
        }
      </dl>
    </section>

    <section slot="more" aria-labelledby="next-heading" class="max-w-[68ch]">
      <h2 id="next-heading" class="font-display text-h2 font-bold text-ink">
        {t('practicePage.nextHeading')}
      </h2>
      <p class="mt-4 leading-relaxed text-muted">
        <Rich
          nodes={t.rich('practicePage.nextBody', {
            copy: copy.navLabel,
            seconds: FACTS.challengeSeconds,
          })}
          tags={{
            copy: { href: copy.key, class: link },
            challenge: { href: challenge.key, class: link },
          }}
        />
      </p>
    </section>

    <Faq slot="more" items={faq} />
  </PageShell>
</BaseLayout>
