---
import BaseLayout from '../layouts/BaseLayout.astro'
import { PracticeScreen } from '../components/Practice/PracticeScreen'

const title = 'Morse Code Practice — Listen, Read and Send | MorseForge'
const description =
  'Free Morse code practice in three modes: hear a character and name it, read the dots and dashes, or key it yourself. Spaced repetition picks what you are closest to forgetting.'
---

<BaseLayout title={title} description={description} path="/practice/">
  <main class="mx-auto max-w-4xl px-6 py-14">
    <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Practice</h1>
    <p class="mt-3 leading-relaxed text-muted">
      Three modes, because recognising a character, hearing it and sending it are different skills —
      and mastery needs all three. Prompts are chosen by what you are closest to forgetting.
    </p>

    <div class="mt-10">
      <PracticeScreen client:load />
    </div>

    <p class="mt-10 text-sm leading-relaxed text-muted">
      Comfortable with single characters? <a
        href="/copy/"
        class="text-signal underline underline-offset-4">Copy practice</a
      > sends whole lines — code groups, words and callsigns — and grades what you wrote character by
      character.
    </p>
  </main>
</BaseLayout>
