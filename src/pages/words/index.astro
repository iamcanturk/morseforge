---
import BaseLayout from '../../layouts/BaseLayout.astro'
import {
  WORDS,
  WORD_CATEGORIES,
  morseFor,
  wordsByCategory,
  type WordCategory,
} from '../../data/words'
import { prettify } from '../../engine/morseEncoder'
import { SITE } from '../../config/site'

const path = '/words/'
const title = 'Words in Morse Code — SOS, I Love You, CQ and More | MorseForge'
const description = `${WORDS.length} common words and phrases in Morse code, each with audio, a character-by-character breakdown, and what it actually means to an operator. Free, no account.`

const categories = Object.keys(WORD_CATEGORIES) as WordCategory[]

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Words in Morse code',
    description,
    url: new URL(path, SITE.url).href,
    isPartOf: { '@id': `${SITE.url}/#website` },
    // ItemList rather than a bare page: it tells a crawler this is an index of
    // N specific things, which is what surfaces the individual word pages.
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: WORDS.length,
      itemListElement: WORDS.map((word, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: `${word.text} in Morse code`,
        url: `${SITE.url}/words/${word.slug}/`,
      })),
    },
  },
]
---

<BaseLayout title={title} description={description} path={path} schema={schema}>
  <main class="mx-auto max-w-4xl px-6 py-14">
    <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Words in Morse code</h1>

    <p class="mt-5 max-w-2xl text-lg leading-relaxed">
      {WORDS.length} words and phrases people actually look up, each with playable audio and a character-by-character
      breakdown. Every code here is generated by the same engine that runs the trainer, so nothing on
      these pages can drift out of sync with what you practise.
    </p>

    {
      categories.map((category) => (
        <section class="mt-14">
          <h2 class="font-display text-xl font-bold tracking-tight">
            {WORD_CATEGORIES[category].label}
          </h2>
          <p class="mt-1.5 text-sm text-muted">{WORD_CATEGORIES[category].blurb}</p>

          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {wordsByCategory(category).map((word) => (
              <li>
                <a
                  href={`/words/${word.slug}/`}
                  class="block rounded-xl border border-line bg-panel p-4 transition-colors hover:border-signal-dim"
                >
                  <span class="font-display text-lg font-semibold text-ink">{word.text}</span>
                  <span class="mt-1.5 block font-mono text-sm break-all text-cyan">
                    {prettify(morseFor(word))}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <aside class="mt-16 rounded-xl border border-line bg-panel p-6">
      <h2 class="font-display text-lg font-semibold">Want to send these yourself?</h2>
      <p class="mt-2 leading-relaxed text-muted">
        Reading Morse and sending it are different skills. The seven-day plan gets you from two
        characters to the full alphabet, and the telegraph lets you key any of these words with your
        own keyboard.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href="/learn-morse-code-in-7-days/"
          class="rounded-lg px-5 py-2.5 font-mono text-xs tracking-[0.14em] text-void"
          style="background: var(--color-signal)">THE 7-DAY PLAN</a
        >
        <a
          href="/telegraph/"
          class="rounded-lg border border-line px-5 py-2.5 font-mono text-xs tracking-[0.14em] text-muted transition-colors hover:border-signal hover:text-signal"
          >SEND IT YOURSELF</a
        >
      </div>
    </aside>
  </main>
</BaseLayout>
