---
import '../../styles/pkg-i.css'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageShell from '../../components/PageShell.astro'
import { breadcrumbTrail, getPage } from '../../config/pages'
import { FACTS, wordFacts } from '../../config/facts'
import { numberWord } from '../../data/format'
import {
  WORDS,
  WORD_CATEGORIES,
  morseFor,
  wordLabel,
  wordsByCategory,
  type WordCategory,
} from '../../data/words'
import { prettify } from '../../engine/morseEncoder'
import { absoluteUrl, breadcrumbs, webPage } from '../../seo/schema'

const page = getPage('/words/')
const trail = breadcrumbTrail(page.path)
const categories = Object.keys(WORD_CATEGORIES) as WordCategory[]
const listId = `${absoluteUrl(page.path)}#list`

const schema = [
  webPage({
    path: page.path,
    name: page.h1,
    description: page.description,
    type: 'CollectionPage',
    mainEntityId: listId,
  }),
  {
    // An ItemList rather than a bare page: it tells a crawler this is an index
    // of N specific things, which is what surfaces the individual word pages.
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    '@id': listId,
    numberOfItems: WORDS.length,
    itemListElement: WORDS.map((word, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${wordLabel(word)} in Morse code`,
      url: absoluteUrl(`/words/${word.slug}/`),
    })),
  },
  breadcrumbs(trail),
]
---

<BaseLayout title={page.title} description={page.description} path={page.path} schema={schema}>
  <PageShell
    width="tool"
    trail={trail}
    eyebrow={`Telegrams · ${FACTS.wordCount} on file`}
    h1={page.h1}
    intro={page.intro}
  >
    <nav aria-label="Categories" class="flex flex-wrap gap-2">
      {
        categories.map((category) => (
          <a href={`#${category}`} class="mf-chip-link">
            {WORD_CATEGORIES[category].label}
          </a>
        ))
      }
    </nav>

    {
      categories.map((category) => (
        <section id={category} aria-labelledby={`${category}-heading`} class="mt-16">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-line pb-3">
            <h2 id={`${category}-heading`} class="font-display text-h2 font-bold text-ink">
              {WORD_CATEGORIES[category].label}
            </h2>
            <p class="text-sm text-muted">{WORD_CATEGORIES[category].blurb}</p>
          </div>

          <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {wordsByCategory(category).map((word) => (
              <li>
                <a href={`/words/${word.slug}/`} class="pi-telegram block h-full p-5">
                  <span class="pi-telegram-band flex items-center justify-between gap-3 pb-2">
                    <span class="pi-form-label">Telegram</span>
                    <span class="pi-form-label">
                      {wordFacts(word).sendSeconds}s at {FACTS.exampleWpm} WPM
                    </span>
                  </span>
                  <span class="mt-4 block font-display text-h3 font-bold">{wordLabel(word)}</span>
                  <span class="pi-code mt-2 block font-mono text-base">
                    {prettify(morseFor(word))}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <aside slot="more" class="mf-instrument p-6 sm:p-8">
      <p class="mf-engraved text-brass">Next step</p>
      <h2 class="pi-balance mt-3 font-display text-h2 font-bold text-ink">
        Want to send these yourself?
      </h2>
      <p class="pi-pretty mt-4 max-w-[62ch] leading-relaxed text-muted">
        Reading Morse and sending it are different skills. The {numberWord(FACTS.planDays)}-day plan
        takes you from the first {numberWord(FACTS.planFirstDayCharacters.length)} characters to the full
        alphabet, and the telegraph lets you key any of these words with your own keyboard.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/learn-morse-code-in-7-days/"
          class="mf-btn mf-btn-primary max-w-full whitespace-normal py-2 text-center leading-snug"
        >
          Learn Morse code in {FACTS.planDays} days
        </a>
        <a
          href="/telegraph/"
          class="mf-btn mf-btn-secondary max-w-full whitespace-normal py-2 text-center leading-snug"
          >Send it on the key</a
        >
        <a
          href="/morse-code-alphabet/"
          class="mf-btn mf-btn-ghost max-w-full whitespace-normal py-2 text-center leading-snug"
          >The Morse code alphabet</a
        >
      </div>
    </aside>
  </PageShell>
</BaseLayout>
