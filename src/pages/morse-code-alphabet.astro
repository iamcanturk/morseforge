---
import BaseLayout from '../layouts/BaseLayout.astro'
import AlphabetChart, { type ChartPlate } from '../components/Alphabet/AlphabetChart.astro'
import Faq from '../components/Faq.astro'
import PageShell from '../components/PageShell.astro'
import { characterHref, characterPageSlugs } from '../components/Alphabet/characterLinks'
import { breadcrumbTrail, getPage } from '../config/pages'
import { FACTS, spanOf } from '../config/facts'
import { CITATIONS } from '../config/site'
import { CHARACTERS } from '../data/characters'
import { faqFor } from '../data/faq'
import { describeElements, numberWord } from '../data/format'
import {
  ALL_DIGITS,
  ALL_LETTERS,
  DIGITS,
  ITU_PUNCTUATION,
  LETTERS,
  NON_ITU_PUNCTUATION,
} from '../data/morseAlphabet'
import { encode, prettify } from '../engine/morseEncoder'
import { breadcrumbs, characterTerms, definedTermSet, termSetId, webPage } from '../seo/schema'

const page = getPage('/morse-code-alphabet/')
const faq = faqFor(page.path)
const trail = breadcrumbTrail(page.path)
const ITU = CITATIONS.itu.short

const toEntries = (source: Readonly<Record<string, string>>) =>
  Object.entries(source).map(([character, code]) => ({ character, code }))

// Integer-like keys iterate in numeric order, 0 first. The chart puts 0 last
// so the two rows read 1–5 then 6–0, and the counting pattern lines up.
const digits = toEntries(DIGITS).sort(
  (a, b) => (Number(a.character) || 10) - (Number(b.character) || 10),
)

const plates: ChartPlate[] = [
  {
    id: 'letters',
    heading: `Morse code letters ${spanOf(ALL_LETTERS)}`,
    tab: `${spanOf(ALL_LETTERS)} · ${FACTS.letterCount}`,
    entries: toEntries(LETTERS),
  },
  {
    id: 'numbers',
    heading: `Morse code numbers ${spanOf(ALL_DIGITS)}`,
    tab: `${spanOf(ALL_DIGITS)} · ${FACTS.digitCount}`,
    entries: digits,
    cols: 5,
  },
  {
    id: 'punctuation',
    heading: `Punctuation in ${ITU}`,
    tab: `${ITU} · ${FACTS.ituPunctuationCount}`,
    note: `The standard defines ${FACTS.ituPunctuationCount} punctuation marks. It also has a multiplication sign, which is sent exactly like the letter X (${prettify(encode('X'))}), so it is not listed separately here.`,
    entries: toEntries(ITU_PUNCTUATION),
    named: true,
  },
  {
    id: 'common-punctuation',
    heading: `Common but not in ${ITU}`,
    tab: `Not in the standard · ${FACTS.nonItuPunctuationCount}`,
    note: `These ${numberWord(FACTS.nonItuPunctuationCount)} marks are widely used and every MorseForge tool accepts them, but ${ITU} does not define them, so a receiver may not know them.`,
    entries: toEntries(NON_ITU_PUNCTUATION),
    named: true,
  },
]

// Shown characters, in chart order: the same set the term set describes.
const shown = plates.flatMap((plate) => plate.entries.map((entry) => entry.character))

// Character pages are a separate route that may not exist yet, or may cover
// only some characters. Link only to the pages the build actually produces.
const slugs = await characterPageSlugs()
const links = new Map(
  shown.flatMap((character) => {
    const href = characterHref(character, slugs)
    return href ? [[character, href] as const] : []
  }),
)

const terms = shown.flatMap((character) => {
  const facts = CHARACTERS[character]
  return facts ? characterTerms([facts], { linked: links.has(character) }) : []
})

const schema = [
  webPage({
    path: page.path,
    name: page.h1,
    description: page.description,
    type: 'CollectionPage',
    mainEntityId: termSetId(page.path),
  }),
  breadcrumbs(trail),
  definedTermSet({
    path: page.path,
    name: 'International Morse code',
    description: page.description,
    terms,
  }),
]

const digitSentence = (digit: keyof typeof DIGITS) =>
  `${digit} is ${describeElements(DIGITS[digit])}`
---

<BaseLayout title={page.title} description={page.description} path={page.path} schema={schema}>
  <PageShell
    width="tool"
    trail={trail}
    eyebrow={`Reference · ${ITU}`}
    h1={page.h1}
    intro={page.intro}
  >
    <dl class="grid max-w-[22rem] grid-cols-3 gap-3" data-print="hide">
      <div class="mf-readout">
        <dt class="mf-readout-label mf-engraved">Letters</dt>
        <dd class="mf-readout-value">{FACTS.letterCount}</dd>
      </div>
      <div class="mf-readout">
        <dt class="mf-readout-label mf-engraved">Digits</dt>
        <dd class="mf-readout-value">{FACTS.digitCount}</dd>
      </div>
      <div class="mf-readout">
        <dt class="mf-readout-label mf-engraved">Marks</dt>
        <dd class="mf-readout-value">{FACTS.ituPunctuationCount}</dd>
      </div>
    </dl>

    <div class="mt-10">
      <AlphabetChart plates={plates} links={links} />
    </div>

    <section slot="more" class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]" data-print="hide">
      <div class="max-w-[68ch]">
        <h2 class="pi-balance font-display text-h2 font-bold text-ink">
          Why the codes are what they are
        </h2>
        <p class="pi-pretty mt-4 leading-relaxed text-muted">
          The alphabet is not arbitrary. Morse is a prefix tree: from a starting point, a dot
          branches one way and a dash the other, and every character sits where its own sequence
          lands. E is one dot because E is the most common letter in English, and the shortest codes
          went to the letters that would be sent most often.
        </p>
        <p class="pi-pretty mt-4 leading-relaxed text-muted">
          The digits give this away most clearly. {digitSentence('1')}, {digitSentence('2')}, and so
          on until {digitSentence('5')}. Then the pattern turns around: {digitSentence('6')}, and so
          on until {digitSentence('0')}. It is a rule you can derive rather than a table you have to
          memorise.
        </p>
      </div>

      <nav aria-label="Related" class="mf-panel self-start p-5 sm:p-6">
        <p class="mf-engraved">Keep going</p>
        <ul class="mt-4 space-y-3">
          <li><a href="/tree/" class="pi-link">See the Morse code tree</a></li>
          <li>
            <a href="/learn-morse-code-in-7-days/" class="pi-link"
              >Learn Morse code in {FACTS.planDays} days</a
            >
          </li>
          <li><a href="/morse-code-translator/" class="pi-link">Translate your own text</a></li>
          <li>
            <a href="/words/" class="pi-link">{FACTS.wordCount} words in Morse code</a>
          </li>
        </ul>
      </nav>
    </section>

    <div slot="more" data-print="hide">
      <Faq items={faq} />
    </div>
  </PageShell>
</BaseLayout>
