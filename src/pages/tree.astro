---
import BaseLayout from '../layouts/BaseLayout.astro'
import Faq from '../components/Faq.astro'
import PageShell from '../components/PageShell.astro'
import Rich from '../components/I18n/Rich.astro'
import { SignalTreeIsland } from '../components/SignalTree/SignalTreeScreen'
import { FACTS } from '../config/facts'
import { CHARACTERS } from '../data/characters'
import { CURRICULUM } from '../data/curriculum'
import { ALL_LETTERS, MORSE_ALPHABET } from '../data/morseAlphabet'
import { MORSE_TREE, treeDepth } from '../data/tree'
import { prettify } from '../engine/morseEncoder'
import { LEVEL_REQUIREMENTS, SKILLS } from '../game/mastery'
import { breadcrumbs, webPage } from '../seo/schema'
import { useTranslations } from '../i18n/server'

const t = useTranslations(Astro)
const page = t.page('/tree/')
const plan = t.page('/learn-morse-code-in-7-days/')
const lessons = t.page('/learn/')
const alphabet = t.page('/morse-code-alphabet/')
const trail = t.trail(page.key)
const faq = t.faq(page.key)

const schema = [
  webPage({ path: page.path, name: page.h1, description: page.description }),
  breadcrumbs(trail),
]

/* ---- Every figure below is computed from the alphabet and the plan. ---- */

const depth = treeDepth(MORSE_TREE)
const byLength = FACTS.lettersByLength
const rows = Array.from({ length: depth }, (_, index) => byLength[index + 1] ?? [])
const lastRowSlots = 2 ** depth
const lastRow = rows.at(-1) ?? []

/** The letter one element away: same code with the last element flipped. */
function sibling(letter: string): string | null {
  const code = MORSE_ALPHABET[letter] ?? ''
  const flipped = code.slice(0, -1) + (code.endsWith('.') ? '-' : '.')
  return ALL_LETTERS.find((other) => MORSE_ALPHABET[other] === flipped) ?? null
}

// Worked examples, chosen by rule rather than by hand: the first two-element
// letter that is dot-then-dash, and the first three-element dot-first letter.
const example = (byLength[2] ?? []).find((letter) => MORSE_ALPHABET[letter]?.startsWith('.-'))
const exampleFacts = example ? CHARACTERS[example] : undefined
const pairs = [byLength[2]?.[0], byLength[3]?.[0]]
  .filter((letter): letter is string => Boolean(letter))
  .map((letter) => [letter, sibling(letter)] as const)
  .filter((pair): pair is readonly [string, string] => pair[1] !== null)

// The plan's claim, checked at build time: every day teaches characters of
// one length, and no day teaches longer characters before shorter ones. If
// the curriculum ever stops following the tree, this page must stop saying so.
const lengths = CURRICULUM.map((day) => [
  ...new Set(day.characters.map((character) => MORSE_ALPHABET[character]?.length ?? 0)),
])
const followsTree =
  lengths.every((set) => set.length === 1) &&
  lengths.every((set, index) => index === 0 || set[0]! >= lengths[index - 1]![0]!)
if (!followsTree) throw new Error('tree.astro: the 7-day plan no longer follows the tree rows')
const isKind = (kind: string) => (character: string) => CHARACTERS[character]?.kind === kind
const letterDays = CURRICULUM.filter((day) => day.characters.every(isKind('letter')))
const lastDay = CURRICULUM.at(-1)!
const lastDayIsDigits = lastDay.characters.every(isKind('digit'))
// Four-element patterns that are not letters but are something else in the data.
const otherFours = Object.entries(MORSE_ALPHABET).filter(
  ([character, code]) => code.length === depth && !ALL_LETTERS.includes(character as never),
).length
const firstDay = CURRICULUM[0]!
const mastery = LEVEL_REQUIREMENTS[5]

const depthParams = {
  top: t.list(rows[0] ?? []),
  row2: t.numberWord(rows[1]?.length ?? 0),
  row3: t.numberWord(rows[2]?.length ?? 0),
  row4: t.numberWord(lastRow.length),
  letters: ALL_LETTERS.length,
  depth,
  slots: lastRowSlots,
  used: lastRow.length,
}
const code = (letter: string) => prettify(MORSE_ALPHABET[letter] ?? '')
const [pairA, pairB] = pairs
const siblings = pairB
  ? t.rich('treePage.siblingsBodyTwo', {
      a: pairA![0],
      aCode: code(pairA![0]),
      b: pairA![1],
      bCode: code(pairA![1]),
      c: pairB[0],
      cCode: code(pairB[0]),
      d: pairB[1],
      dCode: code(pairB[1]),
    })
  : pairA
    ? t.rich('treePage.siblingsBodyOne', {
        a: pairA[0],
        aCode: code(pairA[0]),
        b: pairA[1],
        bCode: code(pairA[1]),
      })
    : t.rich('treePage.siblingsBody')
const planParams = {
  plan: plan.navLabel,
  first: t.list(firstDay.characters),
  letterDays: t.numberWord(letterDays.length),
  letters: ALL_LETTERS.length,
  planTime: FACTS.planTime,
}
---

<BaseLayout title={page.title} description={page.description} path={page.path} schema={schema}>
  <PageShell width="tool" trail={trail} h1={page.h1} intro={page.intro} instrumentFirst>
    <SignalTreeIsland client:idle i18n={t.island('tree')} />

    <div slot="more" class="mf-prose">
      <h2>{t('treePage.readHeading')}</h2>
      <p>
        {
          exampleFacts ? (
            <Rich
              nodes={t.rich('treePage.readBodyExample', {
                character: exampleFacts.character,
                spelled: t.spokenCode(exampleFacts.code),
                display: exampleFacts.display,
              })}
            />
          ) : (
            t('treePage.readBody')
          )
        }
      </p>
      <p>
        {
          otherFours === 0
            ? t('treePage.depthBodyUnused', {
                ...depthParams,
                unused: t.numberWord(lastRowSlots - lastRow.length),
              })
            : t('treePage.depthBody', depthParams)
        }
      </p>
      <p><Rich nodes={siblings} /></p>

      <h2>{t('treePage.orderHeading')}</h2>
      <p>{t('treePage.orderBody')}</p>
      <p>
        <Rich
          nodes={lastDayIsDigits
            ? t.rich('treePage.planBody', {
                ...planParams,
                digits: t.numberWord(FACTS.digitCount),
              })
            : t.rich('treePage.planBodyLettersOnly', planParams)}
          tags={{ lessons: { href: lessons.key }, plan: { href: plan.key } }}
        />
      </p>
      <p>
        <Rich
          nodes={t.rich('treePage.padsBody', {
            attempts: mastery.minAttemptsPerSkill,
            skills: t.numberWord(SKILLS.length),
            percent: Math.round(mastery.minScore * 100),
          })}
          tags={{ alphabet: { href: alphabet.key } }}
        />
      </p>
    </div>

    <Faq slot="more" items={faq} />
  </PageShell>
</BaseLayout>
