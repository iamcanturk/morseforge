---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SignalTreeScreen } from '../components/SignalTree/SignalTreeScreen'

const title = 'Morse Code Tree — See How Every Letter Is Built | MorseForge'
const description =
  'An interactive Morse code binary tree. A dot branches left, a dash branches right, and every letter sits where its code spells it out. Click any letter to hear it.'
---

<BaseLayout title={title} description={description} path="/tree/">
  <main class="mx-auto max-w-6xl px-6 py-14">
    <header class="mb-10">
      <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Morse Code Tree</h1>
      <p class="mt-3 max-w-2xl leading-relaxed text-muted">
        Morse code is a binary tree. From the centre, a dot branches left and a dash branches right
        — so every letter sits exactly where its code spells it out. E is one dot from the core, T
        is one dash, and A is a dot then a dash.
      </p>
    </header>

    <SignalTreeScreen client:load />
  </main>
</BaseLayout>
