---
import '../styles/pkg-i.css'
import BaseLayout from '../layouts/BaseLayout.astro'
import Faq from '../components/Faq.astro'
import PageShell from '../components/PageShell.astro'
import { Translator } from '../components/Translator/Translator'
import { breadcrumbTrail, getPage } from '../config/pages'
import { FACTS } from '../config/facts'
import { faqFor } from '../data/faq'
import { numberWord, plural } from '../data/format'
import { PARIS_UNITS } from '../engine/timingEngine'
import { IDS, absoluteUrl, breadcrumbs, webPage } from '../seo/schema'

const page = getPage('/morse-code-translator/')
const speedPage = getPage('/morse-code-speed/')
const faq = faqFor(page.path)
const trail = breadcrumbTrail(page.path)
const speeds = `${FACTS.wpmMin} to ${FACTS.wpmMax}`

const schema = [
  webPage({
    path: page.path,
    name: page.h1,
    description: page.description,
    mainEntityId: `${absoluteUrl(page.path)}#translator`,
  }),
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    '@id': `${absoluteUrl(page.path)}#translator`,
    name: 'Morse Code Translator',
    url: absoluteUrl(page.path),
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    description: page.description,
    author: { '@id': IDS.author },
    isPartOf: { '@id': IDS.app },
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: [
      'Text to Morse code',
      'Morse code to text',
      `Audio playback from ${speeds} words per minute`,
      'Visual signal lamp mode',
    ],
  },
  breadcrumbs(trail),
]

const units = (count: number) => plural(count, 'unit')

const separators = [
  {
    mark: '(nothing)',
    means: 'Between the dots and dashes of one character',
    length: FACTS.units.ELEMENT_GAP,
  },
  { mark: 'space', means: 'Between two characters', length: FACTS.units.CHARACTER_GAP },
  { mark: '/', means: 'Between two words', length: FACTS.units.WORD_GAP },
]
---

<BaseLayout title={page.title} description={page.description} path={page.path} schema={schema}>
  <PageShell
    width="tool"
    trail={trail}
    eyebrow="Instrument · Text to Morse and back"
    h1={page.h1}
    intro={page.intro}
    instrumentFirst
  >
    <Translator client:load />

    <div slot="more" class="grid grid-cols-1 gap-16 lg:grid-cols-2 lg:gap-12">
      <section aria-labelledby="read-heading">
        <h2 id="read-heading" class="pi-balance font-display text-h2 font-bold text-ink">
          How to read the output
        </h2>
        <p class="pi-pretty mt-4 leading-relaxed text-muted">
          Morse is written with three levels of separation, and getting them right is the difference
          between readable and meaningless.
        </p>

        <div class="mf-panel mt-6 overflow-hidden">
          <table class="pi-table">
            <caption class="sr-only"
              >How Morse code separates elements, characters and words</caption
            >
            <thead>
              <tr>
                <th scope="col">Separator</th>
                <th scope="col">Means</th>
                <th scope="col">Silence</th>
              </tr>
            </thead>
            <tbody>
              {
                separators.map((row) => (
                  <tr>
                    <th scope="row" class="font-mono text-cyan">
                      {row.mark}
                    </th>
                    <td class="text-sm text-muted">{row.means}</td>
                    <td class="font-mono text-sm whitespace-nowrap text-ink">
                      {units(row.length)}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="pi-pretty mt-5 leading-relaxed text-muted">
          A unit is the length of one dot. At {FACTS.exampleWpm} words per minute that is {
            FACTS.unitMs
          } milliseconds, from the PARIS standard: the word PARIS is exactly {PARIS_UNITS} units long
          including its trailing word space, so one unit is {FACTS.unitMsAtOneWpm} milliseconds divided
          by the speed in words per minute. The dot length at every speed from {FACTS.wpmMin} to{
            ' '
          }
          {FACTS.wpmMax} WPM is on the{' '}
          <a href={speedPage.path} class="pi-link">{speedPage.h1}</a> page.
        </p>
      </section>

      <section aria-labelledby="hear-heading">
        <h2 id="hear-heading" class="pi-balance font-display text-h2 font-bold text-ink">
          Hear it: Morse code audio from {speeds} WPM
        </h2>
        <p class="pi-pretty mt-4 leading-relaxed text-muted">
          Press play and the translation is sent as a clean CW tone, timed by the same engine that
          runs the trainer, so a dash is exactly {numberWord(FACTS.units.DASH)} times as long as a dot
          at every speed. Turn on the lamp to watch the same timing as light, the way ships signal with
          an Aldis lamp, or turn the sound off and read it by eye alone.
        </p>
        <p class="pi-pretty mt-4 leading-relaxed text-muted">
          If you are learning to copy by ear, slow speeds teach a bad habit: counting beeps. The
          trainer uses{' '}
          <a href="/blog/what-farnsworth-timing-is/" class="pi-link">Farnsworth timing</a> instead, with
          full-speed characters and longer gaps between them.
        </p>

        <nav aria-label="Related" class="mt-8 grid gap-3 sm:grid-cols-2">
          <a href="/morse-code-alphabet/" class="mf-card">
            <span class="mf-engraved">Reference</span>{' '}
            <span class="font-display text-h3 font-bold">The Morse code alphabet</span>{' '}
            <span class="text-sm text-muted">Every character, playable at your speed.</span>
          </a>
          <a href="/words/" class="mf-card">
            <span class="mf-engraved">Reference</span>{' '}
            <span class="font-display text-h3 font-bold">Words in Morse code</span>{' '}
            <span class="text-sm text-muted">
              {FACTS.wordCount} words and phrases, from SOS to 73.
            </span>
          </a>
        </nav>
      </section>
    </div>

    <Faq slot="more" items={faq} />

    <aside slot="more" class="mf-instrument max-w-3xl p-6 sm:p-8">
      <p class="mf-engraved text-brass">Next step</p>
      <h2 class="pi-balance mt-3 font-display text-h2 font-bold text-ink">
        Translating is not the same as knowing it
      </h2>
      <p class="pi-pretty mt-4 leading-relaxed text-muted">
        A translator is useful once. Learning the alphabet by ear takes about {FACTS.planTime} of practice
        spread over {numberWord(FACTS.planDays)} days; reading it at speed takes{' '}
        <a href="/blog/how-long-does-it-take-to-learn-morse-code/" class="pi-link"
          >months of short daily sessions</a
        >. It is the only way to use Morse without a screen in front of you.
      </p>
      <a
        href="/learn-morse-code-in-7-days/"
        class="mf-btn mf-btn-primary mt-6 max-w-full py-2 text-center leading-snug whitespace-normal"
      >
        Learn Morse code in {FACTS.planDays} days
      </a>
    </aside>
  </PageShell>
</BaseLayout>
