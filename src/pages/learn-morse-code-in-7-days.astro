---
import BaseLayout from '../layouts/BaseLayout.astro'
import Faq from '../components/Faq.astro'
import PageShell from '../components/PageShell.astro'
import { breadcrumbTrail, getPage } from '../config/pages'
import { FACTS } from '../config/facts'
import { CITATIONS } from '../config/site'
import {
  CURRICULUM,
  CURRICULUM_CHARACTER_COUNT,
  charactersThroughDay,
  codeFor,
} from '../data/curriculum'
import { faqFor } from '../data/faq'
import { plural } from '../data/format'
import { prettify } from '../engine/morseEncoder'
import { breadcrumbs, course, howTo } from '../seo/schema'

const page = getPage('/learn-morse-code-in-7-days/')
const lessons = getPage('/learn/')
const practice = getPage('/practice/')
const faq = faqFor(page.path)
const trail = breadcrumbTrail(page.path)

/**
 * Course and HowTo from the same days the page renders, plus the crumb.
 *
 * FAQPage is not here: `<Faq>` emits it next to the visible questions, and a
 * second copy in this graph would put two FAQPage blocks on one URL.
 */
const schema = [
  course({
    path: page.path,
    name: page.h1,
    description: page.description,
    days: CURRICULUM,
    teaches: `International Morse code, ${CITATIONS.itu.short}`,
  }),
  howTo({ path: page.path, name: page.h1, description: page.description, days: CURRICULUM }),
  breadcrumbs(trail),
]

/** "dot dash", for screen readers, which would read the glyphs as symbols. */
const spoken = (code: string) =>
  [...code].map((element) => (element === '.' ? 'dot' : 'dash')).join(' ')

const firstDay = CURRICULUM[0]!.day
const minutesRange = `${FACTS.planMinMinutesPerDay}–${FACTS.planMaxMinutesPerDay}`
---

<BaseLayout title={page.title} description={page.description} path={page.path} schema={schema}>
  {
    /* Answer-first: the intro is the paragraph a search snippet lifts and an
      LLM quotes, so the shell puts it straight under the H1. */
  }
  <PageShell
    width="tool"
    trail={trail}
    eyebrow={`Course · ${FACTS.planDays} days · ${FACTS.planTime}`}
    h1={page.h1}
    intro={page.intro}
    instrumentClass="max-w-4xl"
  >
    <p class="max-w-[62ch] text-muted">
      It is free, there is no account, and every day can be practised in the browser. Codes follow <a
        href={CITATIONS.itu.url}
        rel="noopener"
        class="text-signal underline decoration-signal/40 underline-offset-4 hover:decoration-signal"
        >{CITATIONS.itu.short}</a
      >, the international standard for Morse code.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={lessons.path}
        class="mf-btn mf-btn-primary mf-btn-lg w-full py-3 text-center leading-snug whitespace-normal sm:w-auto"
        >Start day {firstDay}</a
      >
      <a
        href="/tree/"
        class="mf-btn mf-btn-secondary mf-btn-lg w-full py-3 text-center leading-snug whitespace-normal sm:w-auto"
        >See the Morse code tree</a
      >
    </div>

    <dl class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="mf-readout">
        <dt class="mf-readout-label mf-engraved">Days</dt>
        <dd class="mf-readout-value">{FACTS.planDays}</dd>
      </div>
      <div class="mf-readout">
        <dt class="mf-readout-label mf-engraved">Characters</dt>
        <dd class="mf-readout-value">{CURRICULUM_CHARACTER_COUNT}</dd>
      </div>
      <div class="mf-readout">
        <dt class="mf-readout-label mf-engraved">Total</dt>
        <dd class="mf-readout-value">{FACTS.planMinutes}<span class="text-h3"> min</span></dd>
      </div>
      <div class="mf-readout">
        <dt class="mf-readout-label mf-engraved">Per day</dt>
        <dd class="mf-readout-value">{minutesRange}<span class="text-h3"> min</span></dd>
      </div>
    </dl>

    <nav aria-labelledby="plan-contents" class="mt-12">
      <h2 id="plan-contents" class="mf-engraved">The plan, day by day</h2>
      <ol class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          CURRICULUM.map((day) => (
            <li class="flex">
              <a href={`#day-${day.day}`} class="mf-card flex w-full flex-col gap-2 p-4">
                <span class="flex items-center justify-between gap-3">
                  <span class="mf-engraved text-amber">Day {day.day}</span>
                  <span class="mf-engraved">{day.minutes} min</span>
                </span>
                <span class="font-display text-base font-bold text-ink">{day.title}</span>
                <span
                  class="flex flex-wrap gap-1.5"
                  aria-label={`Characters: ${day.characters.join(', ')}`}
                >
                  {day.characters.map((character) => (
                    <span class="mf-kbd" aria-hidden="true">
                      {character}
                    </span>
                  ))}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div slot="more" class="grid max-w-4xl gap-10">
      {
        CURRICULUM.map((day) => {
          const known = charactersThroughDay(day.day).length
          return (
            <section
              id={`day-${day.day}`}
              aria-labelledby={`day-${day.day}-heading`}
              class="mf-panel p-6 sm:p-8"
            >
              <div class="flex flex-wrap items-start justify-between gap-4">
                <h2 id={`day-${day.day}-heading`} class="font-display text-h2 font-bold text-ink">
                  Day {day.day}: {day.title}
                </h2>
                <span class="mf-stamp text-amber" aria-hidden="true">
                  Day {day.day}
                </span>
              </div>

              {/* Answer-first again at section level: heading, then the direct
                  answer, then the supporting detail. */}
              <p class="mt-4 max-w-[62ch] leading-relaxed text-ink">{day.summary}</p>

              <h3 class="sr-only">Characters introduced on day {day.day}</h3>
              <dl class="mt-6 grid grid-cols-3 gap-2 sm:gap-3 lg:grid-cols-5">
                {day.characters.map((character) => {
                  const code = codeFor(character)
                  return (
                    <div class="flex flex-col items-center gap-1.5 rounded-control border border-line-strong border-b-2 bg-void px-2 py-3 text-center sm:px-3 sm:py-4">
                      <dt class="font-display text-h2 font-bold text-signal">{character}</dt>
                      <dd class="font-mono text-h3 tracking-code text-ink">
                        <span aria-hidden="true">{prettify(code)}</span>
                        <span class="sr-only">{spoken(code)}</span>
                      </dd>
                      <dd class="mf-engraved">{plural(code.length, 'element')}</dd>
                    </div>
                  )
                })}
              </dl>

              <h3 class="mt-8 font-display text-h3 font-bold text-ink">Why these characters now</h3>
              <p class="mt-2 max-w-[62ch] leading-relaxed text-muted">{day.rationale}</p>

              <h3 class="mt-6 font-display text-h3 font-bold text-ink">Practice</h3>
              <p class="mt-2 max-w-[62ch] leading-relaxed text-muted">{day.drill}</p>

              <h3 class="mt-6 font-display text-h3 font-bold text-ink">
                {`Words you can send after day\u00a0${day.day}`}
              </h3>
              <ul class="mt-3 flex flex-wrap gap-2">
                {day.words.map((word) => (
                  <li class="mf-tape px-3 pt-5 pb-2 text-sm">{word}</li>
                ))}
              </ul>

              <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-5">
                <p class="mf-engraved">
                  {known} of {CURRICULUM_CHARACTER_COUNT} characters · about {day.minutes} min
                </p>
                <div class="flex flex-wrap gap-2">
                  <a
                    href={lessons.path}
                    class="mf-btn mf-btn-secondary mf-btn-sm"
                    aria-label={`Open in lessons: day ${day.day}`}
                  >
                    Open in lessons
                  </a>
                  <a
                    href={practice.path}
                    class="mf-btn mf-btn-ghost mf-btn-sm"
                    aria-label={`Practise day ${day.day}`}
                  >
                    Practise
                  </a>
                </div>
              </div>
            </section>
          )
        })
      }
    </div>

    <Faq slot="more" items={faq} />
  </PageShell>
</BaseLayout>
